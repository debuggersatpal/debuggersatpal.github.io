rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // By default, only authenticated users can read/write
      allow read, write: if request.auth != null;
    }
    
    // Project icons can be read publicly if someone has the long unguessable token URL
    // (Firebase automatically provides this via getDownloadURL())
    // Alternatively, if we want them to load via pure path without token:
    match /projects/{projectId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
