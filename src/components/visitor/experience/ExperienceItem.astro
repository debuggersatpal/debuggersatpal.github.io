---
import type { Experience } from '../../../data/types';

interface Props extends Omit<Experience, 'id' | 'order'> {}

const { role, company, period, description } = Astro.props;
---
<div class="experience-item">
  <div class="meta">
    <p class="period">{period}</p>
  </div>
  <div class="details">
    <h3 class="role">{role}</h3>
    <p class="company">{company}</p>
    <p class="description text-pretty">{description}</p>
  </div>
</div>

<style>
  .experience-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  @media (min-width: 768px) {
    .experience-item {
      flex-direction: row;
      gap: var(--space-8);
    }
    .meta {
      width: 180px;
      flex-shrink: 0;
    }
  }
  .period {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }
  .role {
    font-size: 1.125rem;
    color: var(--text-primary);
    margin: 0;
  }
  .company {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .description {
    margin-top: var(--space-2);
  }
</style>
