---
---
<aside class="sidebar-region">
  <div class="sidebar-content fade-up">
    <div id="sidebar-profile" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-2);">
      <div class="avatar-container">
        <img id="sidebar-avatar" alt="Avatar" style="width: 80px; height: 80px; border-radius: var(--radius-full); object-fit: cover; display: block; background-color: var(--bg-inset);" />
        <div class="status-dot"></div>
      </div>
      
      <h2 id="sidebar-name" style="font-size: 1.5rem; font-weight: 800; line-height: 1.1; margin-top: var(--space-2); letter-spacing: -0.02em;">SATPAL</h2>
      <p id="sidebar-role" style="color: var(--accent-primary); font-weight: 500; font-size: 0.875rem;">Developer</p>
    </div>

    <div class="sidebar-footer desktop-only">
      <div style="display: flex; align-items: center; gap: var(--space-1); color: var(--text-secondary); font-size: 0.875rem; margin-bottom: var(--space-4);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span id="sidebar-location">India</span>
      </div>
      <p id="sidebar-tagline" style="color: var(--text-secondary); line-height: 1.6; font-size: 0.875rem;"></p>
    </div>
  </div>
</aside>

<script>
  import { VisitorDataService } from '../../lib/visitor-data';

  document.addEventListener('astro:page-load', () => {
    
    const avatar = document.getElementById('sidebar-avatar') as HTMLImageElement;
    const name = document.getElementById('sidebar-name');
    const role = document.getElementById('sidebar-role');
    const locationEl = document.getElementById('sidebar-location');
    const tagline = document.getElementById('sidebar-tagline');
  
    async function initSidebar() {
      const pState = await VisitorDataService.getProfile();
      if (pState.status === 'success') {
        const data = pState.data;
        
        if (avatar && data.avatarUrl) {
          VisitorDataService.resolveMediaUrl(data.avatarUrl).then(url => {
            avatar.src = url;
            avatar.style.display = 'block';
          });
        }
        
        if (name) name.textContent = data.name || 'Developer';
        if (role) role.textContent = data.role || '';
        if (locationEl) locationEl.textContent = data.location || '';
        if (tagline) tagline.textContent = data.tagline || '';
      }
    }
  
    initSidebar();
  
  });
</script>

<style>
  .desktop-only {
    display: none !important;
  }
  
  .sidebar-region {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4);
  }

  .avatar-container {
    position: relative;
    display: inline-block;
  }
  
  .status-dot {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 14px;
    height: 14px;
    background-color: var(--primary); /* Assuming a blue dot for status */
    border: 2px solid var(--bg-surface);
    border-radius: 50%;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sidebar-footer {
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .desktop-only {
      display: flex !important;
    }
    .sidebar-region {
      position: fixed;
      top: 72px;
      left: 0;
      width: var(--sidebar-width-desktop);
      height: calc(100vh - 72px);
      border-bottom: none;
      overflow-y: auto;
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
