---
const currentPath = Astro.url.pathname;
---
<aside class="sidebar-region">
  <div class="sidebar-content">
    <div id="sidebar-profile" style="display: none; flex-direction: column; align-items: center; text-align: center; gap: var(--space-2);">
      <div class="avatar-container">
        <img id="sidebar-avatar" alt="Avatar" style="width: 80px; height: 80px; border-radius: var(--radius-full); object-fit: cover; display: none;" />
        <div class="status-dot"></div>
      </div>
      
      <h2 id="sidebar-name" style="font-size: 1.5rem; font-weight: 800; line-height: 1.1; margin-top: var(--space-2); letter-spacing: -0.02em;">SATPAL</h2>
      <p id="sidebar-role" style="color: var(--accent-primary); font-weight: 500; font-size: 0.875rem;">Developer</p>
    </div>

    <nav class="sidebar-nav">
      <a href="/" class={currentPath === '/' ? 'active' : ''}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        Home
      </a>
      <a href="/projects/" class={currentPath.startsWith('/projects') ? 'active' : ''}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        Projects
      </a>
      <a href="/about/" class={currentPath.startsWith('/about') ? 'active' : ''}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        About
      </a>
      <a href="/contact/" class={currentPath.startsWith('/contact') ? 'active' : ''}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        Contact
      </a>
    </nav>

    <div class="sidebar-footer">
      <div style="display: flex; align-items: center; gap: var(--space-1); color: var(--text-secondary); font-size: 0.875rem; margin-bottom: var(--space-4);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span id="sidebar-location">India</span>
      </div>
      <p id="sidebar-tagline" style="color: var(--text-secondary); line-height: 1.6; font-size: 0.875rem;"></p>
      
      <div class="theme-toggle" style="margin-top: var(--space-6); display: inline-flex; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-full); padding: 4px;">
        <button style="background: none; border: none; cursor: pointer; padding: 4px 12px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg></button>
        <button style="background: none; border: none; cursor: pointer; padding: 4px 12px; color: var(--text-tertiary);"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg></button>
      </div>
    </div>
  </div>
</aside>

<script>
  import { VisitorDataService } from '../../lib/visitor-data';
  
  const container = document.getElementById('sidebar-profile');
  const avatar = document.getElementById('sidebar-avatar') as HTMLImageElement;
  const name = document.getElementById('sidebar-name');
  const role = document.getElementById('sidebar-role');
  const locationEl = document.getElementById('sidebar-location');
  const tagline = document.getElementById('sidebar-tagline');

  async function initSidebar() {
    const pState = await VisitorDataService.getProfile();
    if (pState.status === 'success') {
      const data = pState.data;
      if (container) container.style.display = 'flex';
      
      if (avatar && data.avatarUrl) {
        VisitorDataService.resolveMediaUrl(data.avatarUrl).then(url => {
          avatar.src = url;
          avatar.style.display = 'block';
        });
      }
      
      if (name) name.textContent = data.name || 'Developer';
      if (role) role.textContent = data.role || '';
      if (locationEl) locationEl.textContent = data.location || '';
      if (tagline) tagline.textContent = data.tagline || '';
    }
  }

  initSidebar();
</script>

<style>
  .sidebar-region {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4);
  }

  .avatar-container {
    position: relative;
    display: inline-block;
  }
  
  .status-dot {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 14px;
    height: 14px;
    background-color: var(--primary); /* Assuming a blue dot for status */
    border: 2px solid var(--bg-surface);
    border-radius: 50%;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .sidebar-nav a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .sidebar-nav a:hover {
    color: var(--text-primary);
    background-color: var(--bg-inset);
  }

  .sidebar-nav a.active {
    color: var(--accent-primary);
    background-color: var(--accent-primary-bg);
  }

  .sidebar-footer {
    margin-top: auto;
  }

  @media (min-width: 1024px) {
    .sidebar-region {
      position: fixed;
      top: 0;
      left: 0;
      width: 280px; /* Narrower than Home Hero */
      height: 100vh;
      border-bottom: none;
      border-right: 1px solid var(--border-subtle);
      overflow-y: auto;
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
