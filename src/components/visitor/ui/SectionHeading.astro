---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<h2 class="section-heading">{title}</h2>

<style>
  .section-heading {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }
</style>
