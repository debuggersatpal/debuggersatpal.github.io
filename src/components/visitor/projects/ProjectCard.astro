---
import type { ProjectSummary } from '../../../data/types';

interface Props extends ProjectSummary {}

const { slug, title, category, thumbnail } = Astro.props;
---
<a href={`/projects/${slug}`} class="project-card">
  <div class="image-wrapper">
    <img data-media-src={thumbnail} alt={title} loading="lazy" />
  </div>
  <div class="content">
    <p class="category">{category}</p>
    <h3 class="title">{title}</h3>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }
  .project-card:hover {
    transform: translateY(-2px);
  }
  .image-wrapper {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg); /* 12px geometric radii */
    overflow: hidden;
    background-color: var(--border-subtle);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }
  .project-card:hover img {
    transform: scale(1.02);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .category {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .title {
    font-size: 1.125rem;
    color: var(--text-primary);
    margin: 0;
  }
</style>
