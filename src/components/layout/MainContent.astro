---
// src/components/layout/MainContent.astro
import ThemeToggle from "../ui/ThemeToggle.astro";
import ProjectFilters from "../projects/ProjectFilters.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { projects } from "../../data/projects";
---

<main class="main-content">
    <!-- Desktop & Tablet Navigation Area -->
    <nav class="top-nav">
        <div class="nav-left">
            <!-- Hamburger for Tablet (Hidden on Desktop) -->
            <button class="tablet-hamburger" aria-label="Open menu">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>

            <!-- Desktop Links (Hidden on Tablet) -->
            <ul class="desktop-links">
                <li><a href="#projects" class="active">Projects</a></li>
                <li><a href="#experience">Experience</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </div>

        <ThemeToggle />
    </nav>

    <!-- Projects Section -->
    <section id="projects">
        <header class="page-header">
            <h2 class="page-title">All Projects & Works</h2>
            <p class="page-subtitle">Browse every project I've worked on.</p>
        </header>

        <hr class="section-divider" />

        <ProjectFilters />

        <div class="project-grid">
            {projects.map((project) => (
                <ProjectCard project={project} />
            ))}
        </div>

        <div class="view-more-wrapper">
            <a href="#" class="view-more-btn">
                View More Projects
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </section>
</main>

<style>
    .main-content {
        min-width: 0;
    }

    /* ───────── Navigation ───────── */
    .top-nav {
        display: none; /* Hidden on mobile */
    }

    /* ───────── Page Header ───────── */
    .page-header {
        margin-bottom: 1.25rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.35rem;
    }

    .page-subtitle {
        font-size: 0.95rem;
        color: var(--text-secondary);
    }

    /* ───────── Section Divider ───────── */
    .section-divider {
        border: none;
        border-top: 1px solid var(--border-subtle);
        margin-bottom: 1.5rem;
    }

    /* ───────── Project Grid ───────── */
    .project-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    /* ───────── View More Button ───────── */
    .view-more-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 3rem;
    }

    .view-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        background: transparent;
        color: var(--text-primary);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .view-more-btn:hover {
        background: var(--bg-surface);
    }

    /* ───────── Tablet (768px+) ───────── */
    @media (min-width: 768px) {
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
        }

        .tablet-hamburger {
            background: transparent;
            border: none;
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
        }

        .desktop-links {
            display: none;
        }

        .project-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* ───────── Desktop (1024px+) ───────── */
    @media (min-width: 1024px) {
        .tablet-hamburger {
            display: none;
        }

        .top-nav {
            justify-content: flex-end;
            gap: 2rem;
        }

        .nav-left {
            display: flex;
            flex: 1;
            justify-content: flex-end;
            margin-right: 2rem;
        }

        .desktop-links {
            display: flex;
            gap: 2rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .desktop-links a {
            text-decoration: none;
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid transparent;
            transition: color 0.2s ease, border-color 0.2s ease;
        }

        .desktop-links a:hover {
            color: var(--accent-blue);
        }

        .desktop-links a.active {
            color: var(--accent-blue);
            border-bottom-color: var(--accent-blue);
        }

        .project-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
