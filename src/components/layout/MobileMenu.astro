---
// src/components/layout/MobileMenu.astro
interface Props {
  activeNav?: string;
  class?: string;
}

const { activeNav = 'projects' } = Astro.props;

const links = [
  { href: '/projects', label: 'Projects', id: 'projects' },
  { href: '/about', label: 'Profile', id: 'about' },
  { href: '/contact', label: 'Contact', id: 'contact' },
];
---

<div id="mobile-menu-overlay" class="mobile-menu-overlay" aria-hidden="true">
  <div class="mobile-menu-content">
    <div class="mobile-menu-header">
      <span class="menu-title">Menu</span>
      <button id="close-menu-btn" class="close-btn" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="mobile-nav-links">
      {links.map(link => (
        <a href={link.href} class={`mobile-link ${activeNav === link.id ? 'active' : ''}`}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  .mobile-menu-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(17, 24, 39, 0.6);
    z-index: 100;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .mobile-menu-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .mobile-menu-content {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 280px;
    max-width: 85%;
    background-color: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.2s ease;
  }

  .mobile-menu-overlay.is-open .mobile-menu-content {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .menu-title {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.1rem;
  }

  .close-btn {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    margin-right: -0.5rem;
    transition: opacity 0.2s ease;
  }
  
  .close-btn:hover {
    opacity: 0.7;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 1.05rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .mobile-link:hover:not(.active) {
    background-color: var(--border-subtle);
    color: var(--text-primary);
  }

  .mobile-link.active {
    background-color: var(--accent-blue-bg);
    color: var(--accent-blue);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .mobile-menu-overlay {
      display: none !important;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const overlay = document.getElementById('mobile-menu-overlay');
    const closeBtn = document.getElementById('close-menu-btn');
    const hamburgers = document.querySelectorAll('.hamburger-menu, .tablet-hamburger');

    if (!overlay) return;

    // Clean up old overlay listeners by cloning (to prevent duplicate events on navigation)
    const newOverlay = overlay.cloneNode(true) as HTMLElement;
    if (overlay.parentNode) {
      overlay.parentNode.replaceChild(newOverlay, overlay);
    }
    
    const newCloseBtn = document.getElementById('close-menu-btn');

    function openMenu() {
      newOverlay.classList.add('is-open');
      newOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      newOverlay.classList.remove('is-open');
      newOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      if (newOverlay.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // Toggle on hamburger click
    hamburgers.forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLElement;
      if (btn.parentNode) {
        btn.parentNode.replaceChild(newBtn, btn);
      }
      newBtn.addEventListener('click', toggleMenu);
    });

    // Close on close button click
    if (newCloseBtn) {
      newCloseBtn.addEventListener('click', closeMenu);
    }

    // Close on backdrop click
    newOverlay.addEventListener('click', (e) => {
      if (e.target === newOverlay) {
        closeMenu();
      }
    });

    // Close on escape key
    // We attach this to document. We should be careful with duplicate document listeners
    // To handle this properly in an SPA, we could assign the handler to a global variable
    // and remove it if it exists before adding a new one, but for simplicity we'll just check
    if (!(window as any)._mobileMenuEscHandler) {
      (window as any)._mobileMenuEscHandler = (e: KeyboardEvent) => {
        const currentOverlay = document.getElementById('mobile-menu-overlay');
        if (e.key === 'Escape' && currentOverlay && currentOverlay.classList.contains('is-open')) {
          currentOverlay.classList.remove('is-open');
          currentOverlay.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      };
      document.addEventListener('keydown', (window as any)._mobileMenuEscHandler);
    }
  }

  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
  });
</script>
