---
import ProjectFilters from "./ProjectFilters.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../../data/projects";

const pathname = Astro.url.pathname;
const isProjectsRoute = pathname === '/projects' || pathname === '/projects/';
---
<section id="projects">
    <header class="page-header">
        <h2 class="page-title">All Projects & Works</h2>
        <p class="page-subtitle">Browse every project I've worked on.</p>
    </header>

    <hr class="section-divider" />

    <ProjectFilters />

    <div class="project-grid" id="project-grid">
        {projects.map((project) => (
            <ProjectCard project={project} />
        ))}
    </div>

    <div id="projects-empty-state" class="empty-state" style="display: none;">
        <p>No projects found in this category.</p>
    </div>

    {!isProjectsRoute && (
        <div class="view-more-wrapper">
            <a href="/projects" class="view-more-btn">
                View More Projects
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    )}
</section>

<script>
  import { getPublishedProjects } from "../../lib/portfolio-data";
  import { techBadgeColors } from "../../data/projects";

  async function loadProjects() {
    try {
      const projects = await getPublishedProjects();
      if (!projects || projects.length === 0) return;

      const grid = document.getElementById('project-grid');
      if (!grid) return;

      let html = '';
      projects.forEach(p => {
        const fallback = p.fallbackText || p.title.substring(0, 2).toUpperCase();
        const bg = p.brandColor || 'var(--bg-main)';
        
        let iconHtml = `<span>${fallback}</span>`;
        if (p.iconImage) {
          iconHtml = `<img src="${p.iconImage}" alt="${p.title} logo" class="project-img-icon" style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;" />`;
        }

        const badges = (p.techStack || []).map(tech => 
          `<span class="badge" style="background-color: ${techBadgeColors[tech] || '#6B7280'}">${tech}</span>`
        ).join('');

        let demoHtml = '';
        if (p.demoUrl) {
          demoHtml = `<a href="${p.demoUrl}" class="demo-link" target="_blank" rel="noopener noreferrer">Live Demo <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></a>`;
        }

        let githubHtml = '';
        if (p.githubUrl) {
          githubHtml = `<a href="${p.githubUrl}" class="github-link" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>`;
        }

        html += `
        <article class="project-card" data-category="${p.category}">
          <div class="card-header">
            <div class="project-icon" style="background-color: ${bg}; color: #ffffff; font-weight: 700">
              ${iconHtml}
            </div>
            <div class="card-info">
              <h3 class="project-name">
                <a href="/projects/${p.id}" class="project-link">${p.title}</a>
              </h3>
              <div class="tech-badges">
                ${badges}
              </div>
            </div>
          </div>
          <p class="project-desc">${p.description}</p>
          <hr class="card-divider" />
          <div class="card-footer" style="${!p.demoUrl && p.githubUrl ? 'justify-content: flex-end;' : ''}">
            ${demoHtml}
            ${githubHtml}
          </div>
        </article>`;
      });

      grid.innerHTML = html;
      
      // Apply saved filter instead of simulating a click
      if (typeof window !== 'undefined') {
        const savedFilter = sessionStorage.getItem('activeProjectFilter') || 'All';
        let visibleCount = 0;
        const dynamicCards = document.querySelectorAll('.project-card');
        dynamicCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (savedFilter === 'All' || savedFilter === cardCategory) {
            (card as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
        const emptyState = document.getElementById('projects-empty-state');
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }
    } catch (err) {
      console.error("Failed to load Firebase projects", err);
    }
  }

  document.addEventListener('astro:page-load', () => {
    loadProjects();
  });
</script>

<style>
    /* ───────── Page Header ───────── */
    .page-header {
        margin-bottom: 1.25rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.35rem;
    }

    .page-subtitle {
        font-size: 0.95rem;
        color: var(--text-secondary);
    }

    /* ───────── Section Divider ───────── */
    .section-divider {
        border: none;
        border-top: 1px solid var(--border-subtle);
        margin-bottom: 1.5rem;
    }

    .project-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    /* ───────── Empty State ───────── */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        border: 1px dashed var(--border-subtle);
        border-radius: 12px;
        color: var(--text-secondary);
        margin-bottom: 2rem;
        background-color: var(--bg-surface);
    }

    /* ───────── View More Button ───────── */
    .view-more-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 3rem;
    }

    .view-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        background: transparent;
        color: var(--text-primary);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .view-more-btn:hover {
        background: var(--bg-surface);
    }

    /* ───────── Tablet (768px+) ───────── */
    @media (min-width: 768px) {
        .project-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* ───────── Desktop (1024px+) ───────── */
    @media (min-width: 1024px) {
        .project-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
