---
interface Props {
  activeNav?: string;
}

const { activeNav = 'dashboard' } = Astro.props;

const primaryNavItems = [
  { label: 'Dashboard', href: '/me', id: 'dashboard' },
  { label: 'Projects', href: '/me/projects', id: 'projects' },
  { label: 'Experience', href: '/me/experience', id: 'experience' },
  { label: 'Skills', href: '/me/skills', id: 'skills' },
];

const contentNavItems = [
  { label: 'About', href: '/me/about', id: 'about' },
  { label: 'Contact', href: '/me/contact', id: 'contact' },
];

const settingsNavItems = [
  { label: 'Settings', href: '/me/settings', id: 'settings' },
];
---
<div class="mobile-cms-header">
  <div class="mobile-cms-title">
    <a href="/" class="site-title" target="_blank" title="View Public Site">
      Portfolio CMS
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
    </a>
  </div>
  <button id="cms-menu-toggle" class="cms-menu-btn" aria-expanded="false" aria-controls="cms-drawer" aria-label="Open CMS Menu">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
</div>

<div id="cms-drawer-overlay" class="cms-drawer-overlay" aria-hidden="true">
  <nav id="cms-drawer" class="me-sidebar">
    <div class="drawer-mobile-header">
      <span class="drawer-title">Menu</span>
      <button id="cms-menu-close" class="cms-menu-close-btn" aria-label="Close CMS Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="sidebar-header">
      <a href="/" class="site-title" target="_blank" title="View Public Site">
        Portfolio CMS
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </div>
    
    <div class="nav-groups-container">
      <div class="nav-group">
        <span class="nav-group-label">Primary</span>
        <ul class="nav-links">
          {primaryNavItems.map(item => (
            <li>
              <a href={item.href} class={`drawer-link ${activeNav === item.id ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nav-group">
        <span class="nav-group-label">Content</span>
        <ul class="nav-links">
          {contentNavItems.map(item => (
            <li>
              <a href={item.href} class={`drawer-link ${activeNav === item.id ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nav-group">
        <span class="nav-group-label">System</span>
        <ul class="nav-links">
          {settingsNavItems.map(item => (
            <li>
              <a href={item.href} class={`drawer-link ${activeNav === item.id ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <div class="sidebar-footer">
      <button id="logout-btn" class="logout-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sign Out
      </button>
    </div>
  </nav>
</div>

<style>
  /* Mobile Header */
  .mobile-cms-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .cms-menu-btn {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    margin-right: -0.5rem;
  }

  /* Drawer Overlay (Mobile/Tablet) */
  .cms-drawer-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(17, 24, 39, 0.6);
    z-index: 100;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .cms-drawer-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  /* Drawer / Sidebar container */
  .me-sidebar {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 280px;
    max-width: 85%;
    background-color: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.2s ease;
    overflow-y: auto;
  }

  .cms-drawer-overlay.is-open .me-sidebar {
    transform: translateX(0);
  }

  .drawer-mobile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .drawer-title {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.1rem;
  }

  .cms-menu-close-btn {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    margin-right: -0.5rem;
  }

  .sidebar-header {
    display: none;
    margin-bottom: 2.5rem;
  }

  .site-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.5rem;
  }

  .nav-groups-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nav-group-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    padding: 0 0.5rem;
    opacity: 0.7;
  }

  .nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s ease;
    outline: none;
  }

  .nav-links a:hover {
    background-color: var(--bg-main);
    color: var(--text-primary);
  }

  .nav-links a.active {
    background-color: var(--accent-blue-bg);
    color: var(--accent-blue);
    font-weight: 600;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .logout-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.6rem 0.75rem;
    width: 100%;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .logout-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-main);
  }

  /* Desktop >= 1024px */
  @media (min-width: 1024px) {
    .mobile-cms-header {
      display: none;
    }

    .cms-drawer-overlay {
      position: static;
      visibility: visible;
      opacity: 1;
      background-color: transparent;
      z-index: auto;
      display: flex;
      flex-shrink: 0;
      width: var(--sidebar-width-desktop, 280px);
    }

    .me-sidebar {
      position: sticky;
      top: 0;
      width: 100%;
      max-width: none;
      height: 100vh;
      transform: none !important;
      border-right: 1px solid var(--border-subtle);
      padding: 3rem 2rem;
      transition: none;
    }

    .drawer-mobile-header {
      display: none;
    }

    .sidebar-header {
      display: block;
    }

    .nav-links a.active {
      background-color: var(--bg-main);
      color: var(--text-primary);
      position: relative;
    }
    
    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: 50%;
      left: -0.25rem;
      transform: translateY(50%);
      width: 3px;
      height: 16px;
      background-color: var(--text-primary);
      border-radius: 0 3px 3px 0;
    }
  }
</style>

<script>
  import { auth } from '../../lib/firebase';
  import { signOut } from 'firebase/auth';

  function initCMSDrawer() {
    const overlay = document.getElementById('cms-drawer-overlay');
    const toggleBtn = document.getElementById('cms-menu-toggle');
    const closeBtn = document.getElementById('cms-menu-close');
    const drawerLinks = document.querySelectorAll('.drawer-link');
    const logoutBtn = document.getElementById('logout-btn');

    if (!overlay || !toggleBtn) return;

    function openDrawer() {
      overlay?.classList.add('is-open');
      overlay?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      overlay?.classList.remove('is-open');
      overlay?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', openDrawer);
    
    if (closeBtn) {
      closeBtn.addEventListener('click', closeDrawer);
    }

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeDrawer();
      }
    });

    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && overlay?.classList.contains('is-open')) {
        closeDrawer();
      }
    };

    // Remove existing listener if any, then add
    document.removeEventListener('keydown', (window as any).__drawerKeydownHandler);
    document.addEventListener('keydown', handleKeydown);
    (window as any).__drawerKeydownHandler = handleKeydown;

    // Close drawer when clicking a navigation link
    drawerLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          closeDrawer();
        }
      });
    });

    if (logoutBtn && !logoutBtn.dataset.listenerAttached) {
      logoutBtn.dataset.listenerAttached = 'true';
      logoutBtn.addEventListener('click', async () => {
        try {
          await signOut(auth);
        } catch (error) {
          console.error("Error signing out:", error);
        }
      });
    }
  }

  // Use Astro's page-load to initialize on every navigation to prevent duplicate events
  // We attach it carefully. The DOM is fresh, so we just run the initialization.
  document.addEventListener('astro:page-load', () => {
    // Reset body overflow in case we navigated away while drawer was open
    document.body.style.overflow = '';
    initCMSDrawer();
  });
</script>
