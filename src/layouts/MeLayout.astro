---
import BaseLayout from './BaseLayout.astro';
import MeNavigation from '../components/me/MeNavigation.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav } = Astro.props;
---
<BaseLayout title={title}>
  <ClientRouter />
  
  <div id="auth-overlay" class="auth-overlay">
    <div class="loader"></div>
  </div>
  
  <div class="me-shell">
    <MeNavigation activeNav={activeNav} />
    <main class="me-main-content">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .auth-overlay {
    position: fixed;
    inset: 0;
    background-color: var(--bg-main);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.3s ease;
  }

  .loader {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-subtle);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .me-shell {
    min-height: 100vh;
    background-color: var(--bg-main);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
  }

  .me-main-content {
    flex: 1;
    min-width: 0;
    background-color: var(--bg-main);
  }

  @media (min-width: 768px) {
    .me-shell {
      flex-direction: row;
    }
  }
</style>

<script>
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged } from 'firebase/auth';

  function removeOverlay() {
    const overlay = document.getElementById('auth-overlay');
    if (overlay) {
      overlay.style.opacity = '0';
      setTimeout(() => {
        if (overlay.parentNode) overlay.remove();
      }, 300);
    }
  }

  // Client-side auth guard for all /me/* routes
  // This runs once when the module loads
  onAuthStateChanged(auth, (user) => {
    if (!user) {
      // Unauthenticated -> Redirect to login
      window.location.replace('/me/login');
    } else {
      // Authenticated -> Remove overlay
      removeOverlay();
    }
  });

  // Handle subsequent client-side navigations using View Transitions
  document.addEventListener('astro:page-load', () => {
    // If the auth module has already resolved state and user is authenticated,
    // immediately remove the overlay for the newly rendered DOM.
    if (auth.currentUser) {
      removeOverlay();
    }
  });
</script>
