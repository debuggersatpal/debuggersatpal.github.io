---
import BaseLayout from './BaseLayout.astro';
import MeNavigation from '../components/me/MeNavigation.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav } = Astro.props;
---
<BaseLayout title={title}>
  <ClientRouter />
  
  <div id="auth-overlay" class="auth-overlay">
    <div class="loader"></div>
  </div>
  
  <div class="me-shell">
    <MeNavigation activeNav={activeNav} />
    <main class="me-main-content">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .auth-overlay {
    position: fixed;
    inset: 0;
    background-color: var(--bg-main);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.3s ease;
  }

  .loader {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-subtle);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .me-shell {
    min-height: 100vh;
    background-color: var(--bg-main);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
  }

  .me-main-content {
    flex: 1;
    min-width: 0;
    background-color: var(--bg-main);
  }

  @media (min-width: 1024px) {
    .me-shell {
      flex-direction: row;
    }
  }

  /* Global CMS Shared Styles */
  :global(.cms-container) {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  @media (min-width: 768px) {
    :global(.cms-container) {
      padding: 3rem 2rem;
    }
  }

  :global(.cms-header) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (min-width: 600px) {
    :global(.cms-header) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  :global(.page-title) {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.2;
  }
  
  @media (min-width: 768px) {
    :global(.page-title) {
      font-size: 2.25rem;
    }
  }

  :global(.page-subtitle) {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  :global(.header-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Global Button Styles */
  :global(.primary-btn), :global(.secondary-btn), :global(.action-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
  }

  :global(.primary-btn:focus-visible),
  :global(.secondary-btn:focus-visible),
  :global(.action-btn:focus-visible) {
    box-shadow: 0 0 0 2px var(--bg-main), 0 0 0 4px var(--accent-blue);
  }

  :global(.primary-btn) {
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.65rem 1.25rem;
    border: 1px solid var(--text-primary);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  :global(.primary-btn:hover) {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  :global(.primary-btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  :global(.secondary-btn) {
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  :global(.secondary-btn:hover) {
    background-color: var(--bg-surface);
    border-color: var(--text-secondary);
  }

  :global(.action-btn) {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  :global(.action-btn:hover) {
    color: var(--text-primary);
    border-color: var(--text-secondary);
    background-color: var(--bg-surface);
  }

  :global(.delete-btn:hover) {
    color: #ef4444 !important;
    border-color: #ef4444 !important;
    background-color: #fee2e2 !important;
  }

  :global(html.dark .delete-btn:hover) {
    background-color: rgba(239, 68, 68, 0.15) !important;
  }

  :global(.section-divider) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2rem 0;
  }

  /* Form Inputs Global */
  :global(.input-group input), :global(.input-group textarea) {
    background-color: var(--bg-main);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: all 0.2s ease;
  }

  :global(.input-group input:focus), :global(.input-group textarea:focus) {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px var(--accent-blue-bg);
  }
</style>

<script>
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged } from 'firebase/auth';

  function removeOverlay() {
    const overlay = document.getElementById('auth-overlay');
    if (overlay) {
      overlay.style.opacity = '0';
      setTimeout(() => {
        if (overlay.parentNode) overlay.remove();
      }, 300);
    }
  }

  // Client-side auth guard for all /me/* routes
  // This runs once when the module loads
  onAuthStateChanged(auth, (user) => {
    if (!user) {
      // Unauthenticated -> Redirect to login
      window.location.replace('/me/login');
    } else {
      // Authenticated -> Remove overlay
      removeOverlay();
    }
  });

  // Handle subsequent client-side navigations using View Transitions
  document.addEventListener('astro:page-load', () => {
    // If the auth module has already resolved state and user is authenticated,
    // immediately remove the overlay for the newly rendered DOM.
    if (auth.currentUser) {
      removeOverlay();
    }
  });
</script>
