---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Satpal — Developer",
  description = "Personal portfolio of Satpal, developer and builder.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#f7f7f8"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>