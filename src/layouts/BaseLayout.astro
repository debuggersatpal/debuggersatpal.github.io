---
import { ClientRouter } from 'astro:transitions';
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "Satpal — Developer",
  description = "Personal portfolio of Satpal, developer and builder.",
  image = "/images/profile/avatar.jpg",
  type = "website",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://debuggersatpal.github.io');
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
      id="meta-description"
    />

    <meta
      name="theme-color"
      content="#f7f7f8"
    />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonicalURL} />
    
    <meta property="og:title" content={title} id="og-title" />
    <meta property="og:description" content={description} id="og-description" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://debuggersatpal.github.io')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} id="twitter-title" />
    <meta name="twitter:description" content={description} id="twitter-description" />
    <meta name="twitter:image" content={new URL(image, Astro.site || 'https://debuggersatpal.github.io')} />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <title id="page-title">{title}</title>
    
    <!-- Inline script to apply theme before paint -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>

  <body>
    <slot />
    
    <script>
      // Intercept Astro ClientRouter to handle dynamic Firebase projects seamlessly
      document.addEventListener('astro:before-preparation', event => {
        const url = new URL(event.to);
        if (url.pathname.startsWith('/projects/') && url.pathname.length > 10 && !url.pathname.includes('[id]')) {
          event.loader = async () => {
            let response = await fetch(url.pathname);
            if (!response.ok) {
              response = await fetch('/projects/[id]/index.html');
            }
            return response.text(); // Astro 4+ loader returns a string of HTML
          };
        }
      });
    </script>

  </body>
</html>
