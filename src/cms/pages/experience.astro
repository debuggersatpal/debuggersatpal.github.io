---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Experience Editor">
  <div class="cms-header">
    <h1>Experience (Drafts)</h1>
    <div class="cms-actions">
      <button id="btn-add" class="btn btn-primary">Add New Entry</button>
      <button id="btn-publish" class="btn">Publish to Live</button>
    </div>
  </div>
  
  <div id="status-message" class="status-message"></div>
  <div id="loading" class="loading">Loading drafts...</div>

  <div id="experience-list" style="display: flex; flex-direction: column; gap: var(--space-4);"></div>

  <template id="exp-template">
    <div class="cms-form" style="position: relative;">
      <button class="delete-btn btn btn-danger" style="position: absolute; right: 1.5rem; top: 1.5rem; padding: 0.25rem 0.75rem; font-size: 0.8125rem;">Delete</button>
      
      <div class="field">
        <label>ID / Slug</label>
        <input type="text" class="f-id" placeholder="e.g. senior-dev-google" required />
      </div>
      <div class="field">
        <label>Role</label>
        <input type="text" class="f-role" required />
      </div>
      <div class="field">
        <label>Company</label>
        <input type="text" class="f-company" required />
      </div>
      <div class="field">
        <label>Period</label>
        <input type="text" class="f-period" placeholder="2020 - Present" required />
      </div>
      <div class="field">
        <label>Description</label>
        <textarea class="f-desc" rows="3" required></textarea>
      </div>
      <div class="field">
        <label>Technologies (Comma separated, optional)</label>
        <input type="text" class="f-tech" placeholder="e.g. React, Node.js" />
      </div>
      <div class="field">
        <label>Order (lower comes first)</label>
        <input type="number" class="f-order" value="0" required />
      </div>
      
      <div class="cms-actions" style="margin-top: 1rem;">
        <button class="btn btn-primary save-entry-btn">Save Entry Draft</button>
      </div>
    </div>
  </template>

    <div id="empty-state" style="display: none; text-align: center; padding: 3rem; background: var(--cms-card); border-radius: var(--cms-radius); border: 1px dashed var(--cms-border);">
      <p style="color: var(--cms-text); margin-bottom: 1rem;">No experience entries found.</p>
      <button id="btn-add-empty" class="btn btn-primary">Add Your First Entry</button>
    </div>

    <script>
      import { CmsService } from '../../lib/admin/cms-service';
      
      const list = document.getElementById('experience-list');
      const template = document.getElementById('exp-template') as HTMLTemplateElement;
      const loading = document.getElementById('loading');
      const status = document.getElementById('status-message');
      const emptyState = document.getElementById('empty-state');
      const btnPublish = document.getElementById('btn-publish') as HTMLButtonElement;

      function checkEmpty() {
        if (list && emptyState) {
          emptyState.style.display = list.children.length === 0 ? 'block' : 'none';
        }
      }

      function showStatus(msg: string, isError = false) {
        if (!status) return;
        status.textContent = msg;
        status.className = 'status-message ' + (isError ? 'error' : 'success');
        setTimeout(() => status.textContent = '', 5000);
      }

      function createFormNode(data?: any) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const formEl = node.querySelector('.cms-form') as HTMLElement;
        
        const inputs = {
          id: node.querySelector('.f-id') as HTMLInputElement,
          role: node.querySelector('.f-role') as HTMLInputElement,
          company: node.querySelector('.f-company') as HTMLInputElement,
          period: node.querySelector('.f-period') as HTMLInputElement,
          desc: node.querySelector('.f-desc') as HTMLTextAreaElement,
          tech: node.querySelector('.f-tech') as HTMLInputElement,
          order: node.querySelector('.f-order') as HTMLInputElement
        };

        if (data) {
          inputs.id.value = data.id;
          inputs.id.disabled = true; 
          inputs.role.value = data.role;
          inputs.company.value = data.company;
          inputs.period.value = data.period;
          inputs.desc.value = data.description;
          inputs.tech.value = (data.technologies || []).join(', ');
          inputs.order.value = data.order;
        }

        const delBtn = node.querySelector('.delete-btn') as HTMLButtonElement;
        delBtn?.addEventListener('click', async () => {
          if (!data) {
            formEl.remove();
            checkEmpty();
            return;
          }
          if (confirm('Are you sure you want to permanently delete this experience draft?')) {
            const originalText = delBtn.textContent;
            delBtn.disabled = true;
            delBtn.textContent = 'Deleting...';
            try {
              await CmsService.deleteExperienceDraft(data.id);
              formEl.remove();
              showStatus('Draft deleted.');
              checkEmpty();
            } catch (err: any) {
              delBtn.disabled = false;
              delBtn.textContent = originalText;
              showStatus('Error deleting: ' + err.message, true);
            }
          }
        });

        const saveBtn = node.querySelector('.save-entry-btn') as HTMLButtonElement;
        saveBtn?.addEventListener('click', async () => {
          const id = inputs.id.value.trim();
          if (!id || !inputs.role.value) {
            showStatus('ID and Role are required', true);
            return;
          }
          
          const originalText = saveBtn.textContent;
          saveBtn.disabled = true;
          saveBtn.textContent = 'Saving...';

          try {
            const techArr = inputs.tech.value.split(',').map(s => s.trim()).filter(Boolean);
            await CmsService.saveExperienceDraft(id, {
              role: inputs.role.value,
              company: inputs.company.value,
              period: inputs.period.value,
              description: inputs.desc.value,
              technologies: techArr.length ? techArr : undefined,
              order: parseInt(inputs.order.value) || 0
            });
            inputs.id.disabled = true;
            data = { id }; // promote to saved entity
            showStatus(`Saved draft: ${id}`);
          } catch (err: any) {
            showStatus('Error saving: ' + err.message, true);
          } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = originalText;
          }
        });

        return formEl;
      }

      async function init() {
        try {
          const drafts = await CmsService.getExperienceDrafts();
          drafts.forEach(d => list?.appendChild(createFormNode(d)));
          checkEmpty();
        } catch (err: any) {
          showStatus('Failed to load drafts: ' + err.message, true);
        } finally {
          if (loading) loading.style.display = 'none';
        }
      }

      const handleAdd = () => {
        list?.prepend(createFormNode());
        checkEmpty();
      };

      document.getElementById('btn-add')?.addEventListener('click', handleAdd);
      document.getElementById('btn-add-empty')?.addEventListener('click', handleAdd);

      btnPublish?.addEventListener('click', async () => {
        if (!confirm('This will immediately update the live public portfolio with these drafts. Proceed?')) return;
        const originalText = btnPublish.textContent;
        btnPublish.disabled = true;
        btnPublish.textContent = 'Publishing...';
        try {
          await CmsService.triggerServerPublish('experience');
          showStatus('Published successfully to live site!');
        } catch (err: any) {
          showStatus(err.message, true);
        } finally {
          btnPublish.disabled = false;
          btnPublish.textContent = originalText;
        }
      });

      init();
    </script>
</AdminLayout>
