---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Capabilities Editor">
  <div class="cms-header">
    <h1>Capabilities (Drafts)</h1>
    <div class="cms-actions">
      <button id="btn-add" class="btn btn-primary">Add Category</button>
      <button id="btn-publish" class="btn">Publish to Live</button>
    </div>
  </div>
  
  <div id="status-message" class="status-message"></div>
  <div id="loading" class="loading">Loading drafts...</div>

  <div id="capabilities-list" style="display: flex; flex-direction: column; gap: var(--space-4);"></div>

  <template id="cap-template">
    <div class="cms-form" style="position: relative;">
      <button class="delete-btn btn btn-danger" style="position: absolute; right: 1.5rem; top: 1.5rem; padding: 0.25rem 0.75rem; font-size: 0.8125rem;">Delete</button>
      
      <div class="field">
        <label>ID / Slug</label>
        <input type="text" class="f-id" placeholder="e.g. frontend" required />
      </div>
      <div class="field">
        <label>Category Title</label>
        <input type="text" class="f-category" placeholder="e.g. Frontend Development" required />
      </div>
      <div class="field">
        <label>Skills (Comma separated)</label>
        <input type="text" class="f-skills" placeholder="React, Astro, Vue" required />
      </div>
      <div class="field">
        <label>Order (lower comes first)</label>
        <input type="number" class="f-order" value="0" required />
      </div>
      
      <div class="cms-actions" style="margin-top: 1rem;">
        <button class="btn btn-primary save-entry-btn">Save Capability Draft</button>
      </div>
    </div>
  </template>

  <script>
    import { CmsService } from '../../lib/admin/cms-service';
    
    const list = document.getElementById('capabilities-list');
    const template = document.getElementById('cap-template') as HTMLTemplateElement;
    const loading = document.getElementById('loading');
    const status = document.getElementById('status-message');

    function showStatus(msg: string, isError = false) {
      if (!status) return;
      status.textContent = msg;
      status.className = 'status-message ' + (isError ? 'error' : 'success');
      setTimeout(() => status.textContent = '', 5000);
    }

    function createFormNode(data?: any) {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const formEl = node.querySelector('.cms-form') as HTMLElement;
      
      const inputs = {
        id: node.querySelector('.f-id') as HTMLInputElement,
        category: node.querySelector('.f-category') as HTMLInputElement,
        skills: node.querySelector('.f-skills') as HTMLInputElement,
        order: node.querySelector('.f-order') as HTMLInputElement
      };

      if (data) {
        inputs.id.value = data.id;
        inputs.id.disabled = true; 
        inputs.category.value = data.category;
        inputs.skills.value = (data.skills || []).join(', ');
        inputs.order.value = data.order;
      }

      node.querySelector('.delete-btn')?.addEventListener('click', async () => {
        if (!data) {
          formEl.remove();
          return;
        }
        if (confirm('Delete this capability draft?')) {
          await CmsService.deleteCapabilityDraft(data.id);
          formEl.remove();
          showStatus('Draft deleted.');
        }
      });

      node.querySelector('.save-entry-btn')?.addEventListener('click', async () => {
        const id = inputs.id.value.trim();
        if (!id || !inputs.category.value || !inputs.skills.value) {
          showStatus('ID, Category, and Skills are required', true);
          return;
        }
        
        try {
          const skillsArr = inputs.skills.value.split(',').map(s => s.trim()).filter(Boolean);
          await CmsService.saveCapabilityDraft(id, {
            category: inputs.category.value,
            skills: skillsArr,
            order: parseInt(inputs.order.value) || 0
          });
          inputs.id.disabled = true;
          showStatus(`Saved draft: ${id}`);
        } catch (err: any) {
          showStatus('Error saving: ' + err.message, true);
        }
      });

      return formEl;
    }

    async function init() {
      try {
        const drafts = await CmsService.getCapabilitiesDrafts();
        drafts.forEach(d => list?.appendChild(createFormNode(d)));
      } catch (err: any) {
        showStatus('Failed to load drafts: ' + err.message, true);
      } finally {
        if (loading) loading.style.display = 'none';
      }
    }

    document.getElementById('btn-add')?.addEventListener('click', () => {
      list?.prepend(createFormNode());
    });

    document.getElementById('btn-publish')?.addEventListener('click', async () => {
      try {
        await CmsService.triggerServerPublish('capabilities');
        showStatus('Published successfully to live site!');
      } catch (err: any) {
        showStatus(err.message, true);
      }
    });

    init();
  </script>
</AdminLayout>
