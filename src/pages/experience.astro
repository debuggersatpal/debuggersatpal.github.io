---
import AppLayout from "../layouts/AppLayout.astro";

// TEMPORARY STRUCTURAL DEMO DATA
// To be replaced with actual experience data later.
const demoExperience = [
    {
        role: "[Role Placeholder]",
        company: "[Company Placeholder]",
        period: "[Start Date] — [End Date]",
        location: "[Location Placeholder]",
        description: "[Short structural description summarizing the overarching responsibility.]",
        highlights: [
            "[Highlight placeholder bullet point 1]",
            "[Highlight placeholder bullet point 2]"
        ],
        tech: ["[Tech]", "[Tech]", "[Tech]"]
    },
    {
        role: "[Previous Role Placeholder]",
        company: "[Company Placeholder]",
        period: "[Start Date] — [End Date]",
        location: "[Location Placeholder]",
        description: "[Short structural description summarizing the overarching responsibility.]",
        highlights: [
            "[Highlight placeholder bullet point 1]"
        ],
        tech: ["[Tech]", "[Tech]"]
    }
];
---

<AppLayout title="Experience | SATPAL" activeNav="experience">
	<div class="experience-container">
        <header class="page-header">
            <h1 class="page-title">Experience</h1>
            <p class="page-subtitle">My professional journey.</p>
        </header>

        <hr class="section-divider" />

        <div class="experience-list" id="experience-list">
            {demoExperience.map((job) => (
                <article class="experience-entry">
                    <header class="entry-header">
                        <div class="role-company">
                            <h3 class="role">{job.role}</h3>
                            <span class="company">{job.company}</span>
                        </div>
                        <div class="meta-info">
                            <span class="period">{job.period}</span>
                            <span class="separator hidden-desktop">•</span>
                            <span class="location">{job.location}</span>
                        </div>
                    </header>

                    <div class="entry-content">
                        <p class="description">{job.description}</p>
                        
                        <ul class="highlights">
                            {job.highlights.map(hl => (
                                <li>{hl}</li>
                            ))}
                        </ul>

                        <div class="tech-badges">
                            {job.tech.map(t => (
                                <span class="badge">{t}</span>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</AppLayout>

<script>
  import { getPublishedExperience } from "../lib/portfolio-data";

  async function loadExperience() {
    try {
      const exps = await getPublishedExperience();
      if (!exps || exps.length === 0) return;

      const list = document.getElementById('experience-list');
      if (!list) return;

      let html = '';
      exps.forEach(job => {
        const period = job.startDate + (job.endDate ? ` — ${job.endDate}` : ' — Present');
        const loc = job.location || '';
        
        let hlHtml = '';
        if (job.highlights && Array.isArray(job.highlights)) {
          job.highlights.forEach((hl: string) => {
            hlHtml += `<li>${hl}</li>`;
          });
        }

        let techHtml = '';
        if (job.techStack && Array.isArray(job.techStack)) {
          job.techStack.forEach((t: string) => {
            techHtml += `<span class="badge">${t}</span>`;
          });
        }

        html += `
          <article class="experience-entry">
              <header class="entry-header">
                  <div class="role-company">
                      <h3 class="role">${job.role}</h3>
                      <span class="company">${job.company}</span>
                  </div>
                  <div class="meta-info">
                      <span class="period">${period}</span>
                      ${loc ? `<span class="separator hidden-desktop">•</span><span class="location">${loc}</span>` : ''}
                  </div>
              </header>

              <div class="entry-content">
                  <ul class="highlights">
                      ${hlHtml}
                  </ul>

                  <div class="tech-badges">
                      ${techHtml}
                  </div>
              </div>
          </article>
        `;
      });

      list.innerHTML = html;
    } catch (err) {
      console.error("Failed to load Firebase experience", err);
    }
  }

  loadExperience();
</script>

<style>
    .experience-container {
        max-width: 800px;
    }

    /* ───────── Page Header ───────── */
    .page-header {
        margin-bottom: 1.25rem;
    }
    
    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.35rem 0;
        line-height: 1.1;
    }
    
    .page-subtitle {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin: 0;
    }

    /* ───────── Divider ───────── */
    .section-divider {
        border: none;
        border-top: 1px solid var(--border-subtle);
        margin: 2rem 0;
    }

    /* ───────── Experience List ───────── */
    .experience-list {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    .experience-entry {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* ───────── Entry Header ───────── */
    .entry-header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .role-company {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .role {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .company {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--accent-blue);
    }

    .meta-info {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    .separator {
        color: var(--border-subtle);
    }

    /* ───────── Entry Content ───────── */
    .entry-content {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .description {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin: 0;
    }

    .highlights {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .highlights li {
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--text-secondary);
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .highlights li::before {
        content: "▹";
        color: var(--text-secondary);
        font-weight: 700;
    }

    /* ───────── Tech Badges ───────── */
    .tech-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.5rem;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary);
        background-color: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    /* ───────── Tablet/Desktop (768px+) ───────── */
    @media (min-width: 768px) {
        .entry-header {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
        }
        
        .meta-info {
            flex-direction: column;
            align-items: flex-end;
            gap: 0.25rem;
        }

        .hidden-desktop {
            display: none;
        }
    }
</style>
