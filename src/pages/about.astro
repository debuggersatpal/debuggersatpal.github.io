---
import AppLayout from "../layouts/AppLayout.astro";
import { techBadgeColors } from "../data/projects";
---

<AppLayout 
  title="Profile | SATPAL" 
  description="Learn about my background, professional experience, and technical capabilities."
  activeNav="about"
>
	<div class="profile-container">
        <!-- ABOUT SECTION -->
        <section class="profile-section" id="about-section">
            <h1 class="page-title hidden-visually">Profile</h1>
            
            <p class="lead-text" id="profile-intro">
                <span class="skeleton" style="width: 100%;"></span><br/>
                <span class="skeleton" style="width: 80%;"></span>
            </p>

            <div class="prose-block" id="profile-bio">
                <p><span class="skeleton" style="width: 100%;"></span><br/><span class="skeleton" style="width: 95%;"></span><br/><span class="skeleton" style="width: 85%;"></span></p>
                <p><span class="skeleton" style="width: 98%;"></span><br/><span class="skeleton" style="width: 90%;"></span></p>
            </div>

            <div class="focus-area" id="focus-section">
                <h2 class="sub-section-title">Current Focus</h2>
                <ul class="focus-list" id="focus-list">
                    <li><span class="skeleton" style="width: 250px;"></span></li>
                    <li><span class="skeleton" style="width: 200px;"></span></li>
                </ul>
            </div>
        </section>

        <!-- EXPERIENCE SECTION -->
        <section class="profile-section" id="experience-section">
            <h2 class="section-title">Experience</h2>
            <div class="timeline-container" id="experience-timeline">
                <div class="timeline-axis"></div>
                <!-- Skeletons -->
                <article class="timeline-node skeleton-node">
                    <div class="node-dot"></div>
                    <div class="node-content">
                        <header class="node-header">
                            <h3 class="role"><span class="skeleton" style="width: 180px;"></span></h3>
                            <span class="company"><span class="skeleton" style="width: 120px;"></span></span>
                            <span class="period"><span class="skeleton" style="width: 100px;"></span></span>
                        </header>
                        <div class="node-details">
                            <span class="skeleton" style="width: 90%;"></span><br/>
                            <span class="skeleton" style="width: 85%;"></span>
                        </div>
                    </div>
                </article>
                <article class="timeline-node skeleton-node">
                    <div class="node-dot"></div>
                    <div class="node-content">
                        <header class="node-header">
                            <h3 class="role"><span class="skeleton" style="width: 150px;"></span></h3>
                            <span class="company"><span class="skeleton" style="width: 100px;"></span></span>
                            <span class="period"><span class="skeleton" style="width: 90px;"></span></span>
                        </header>
                    </div>
                </article>
            </div>
            <div id="experience-empty" class="empty-state" style="display: none;">
                <p>Experience details coming soon.</p>
            </div>
        </section>

        <!-- SKILLS SECTION -->
        <section class="profile-section" id="skills-section">
            <h2 class="section-title">Capabilities</h2>
            <div class="skills-grid" id="skills-grid">
                <!-- Skeletons -->
                <div class="capability-card skeleton-card">
                    <h3 class="category-title"><span class="skeleton" style="width: 120px;"></span></h3>
                    <div class="skill-pills">
                        <span class="skill-pill skeleton" style="width: 60px;"></span>
                        <span class="skill-pill skeleton" style="width: 80px;"></span>
                    </div>
                </div>
                <div class="capability-card skeleton-card">
                    <h3 class="category-title"><span class="skeleton" style="width: 100px;"></span></h3>
                    <div class="skill-pills">
                        <span class="skill-pill skeleton" style="width: 70px;"></span>
                        <span class="skill-pill skeleton" style="width: 90px;"></span>
                    </div>
                </div>
            </div>
            <div id="skills-empty" class="empty-state" style="display: none;">
                <p>Skills coming soon.</p>
            </div>
        </section>

        <!-- CTA SECTION -->
        <section class="profile-cta">
            <a href="/contact" class="cta-link">
                Get in touch
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </section>
    </div>
</AppLayout>

<script>
  import { getAbout, getPublishedExperience, getPublishedSkills } from "../lib/portfolio-data";
  import { techBadgeColors } from "../data/projects";

  async function loadProfile() {
    // 1. Load About
    try {
      const aboutData = await getAbout();
      const introEl = document.getElementById('profile-intro');
      const bioEl = document.getElementById('profile-bio');
      const focusSection = document.getElementById('focus-section');
      const focusList = document.getElementById('focus-list');

      if (aboutData) {
        if (introEl && aboutData.introduction) {
          introEl.textContent = aboutData.introduction;
          introEl.classList.remove('skeleton');
        } else if (introEl) {
          introEl.style.display = 'none';
        }

        if (bioEl && aboutData.biography) {
          const paragraphs = aboutData.biography.split(/\n\n+/);
          bioEl.innerHTML = paragraphs.map((p: string) => `<p>${p.trim()}</p>`).join('');
        } else if (bioEl) {
          bioEl.style.display = 'none';
        }

        if (focusList && aboutData.focusAreas && Array.isArray(aboutData.focusAreas) && aboutData.focusAreas.length > 0) {
          focusList.innerHTML = aboutData.focusAreas.map((f: string) => `<li>${f}</li>`).join('');
        } else if (focusSection) {
          focusSection.style.display = 'none';
        }
      } else {
        if (introEl) introEl.innerHTML = '<p>Profile information coming soon.</p>';
        if (bioEl) bioEl.style.display = 'none';
        if (focusSection) focusSection.style.display = 'none';
      }
    } catch (err) {
      console.error("Failed to load About data", err);
    }

    // 2. Load Experience
    try {
      const exps = await getPublishedExperience();
      const expTimeline = document.getElementById('experience-timeline');
      const expEmpty = document.getElementById('experience-empty');

      if (exps && exps.length > 0 && expTimeline) {
        let html = '<div class="timeline-axis"></div>';
        exps.forEach(job => {
          const period = job.startDate + (job.endDate ? ` — ${job.endDate}` : ' — Present');
          const loc = job.location ? `<span class="location hidden-mobile">• ${job.location}</span>` : '';
          
          let hlHtml = '';
          if (job.highlights && Array.isArray(job.highlights)) {
            hlHtml = `<ul class="highlights">${job.highlights.map((hl: string) => `<li>${hl}</li>`).join('')}</ul>`;
          }

          let techHtml = '';
          if (job.techStack && Array.isArray(job.techStack) && job.techStack.length > 0) {
            techHtml = `<div class="tech-badges">
              ${job.techStack.map((t: string) => `<span class="badge" style="background-color: ${techBadgeColors[t] || '#6B7280'}">${t}</span>`).join('')}
            </div>`;
          }

          html += `
            <article class="timeline-node">
                <div class="node-dot"></div>
                <div class="node-content">
                    <header class="node-header">
                        <div class="role-company">
                            <h3 class="role">${job.role}</h3>
                            <span class="company">${job.company} ${loc}</span>
                        </div>
                        <span class="period">${period}</span>
                    </header>
                    <div class="node-details">
                        ${hlHtml}
                        ${techHtml}
                    </div>
                </div>
            </article>
          `;
        });
        expTimeline.innerHTML = html;
      } else {
        if (expTimeline) expTimeline.style.display = 'none';
        if (expEmpty) expEmpty.style.display = 'block';
      }
    } catch (err) {
      console.error("Failed to load Experience data", err);
    }

    // 3. Load Skills
    try {
      const skillsData = await getPublishedSkills();
      const skillsGrid = document.getElementById('skills-grid');
      const skillsEmpty = document.getElementById('skills-empty');

      if (skillsData && skillsData.length > 0 && skillsGrid) {
        let html = '';
        skillsData.forEach(section => {
          let itemsHtml = '';
          if (section.skills && Array.isArray(section.skills)) {
            itemsHtml = section.skills.map((item: string) => `<span class="skill-pill">${item}</span>`).join('');
          }
          html += `
            <div class="capability-card">
                <h3 class="category-title">${section.category}</h3>
                <div class="skill-pills">
                    ${itemsHtml}
                </div>
            </div>
          `;
        });
        skillsGrid.innerHTML = html;
      } else {
        if (skillsGrid) skillsGrid.style.display = 'none';
        if (skillsEmpty) skillsEmpty.style.display = 'block';
      }
    } catch (err) {
      console.error("Failed to load Skills data", err);
    }
  }

  document.addEventListener('astro:page-load', () => {
    loadProfile();
  });
</script>

<style>
    .profile-container {
        max-width: 750px;
    }

    .hidden-visually {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .profile-section {
        margin-bottom: 4rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 1.5rem 0;
    }

    /* ───────── ABOUT / BIO ───────── */
    .lead-text {
        font-size: 1.25rem;
        line-height: 1.6;
        font-weight: 500;
        color: var(--text-primary);
        margin: 0 0 2rem 0;
    }

    .prose-block p {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--text-secondary);
        margin: 0 0 1.25rem 0;
    }
    .prose-block p:last-child {
        margin-bottom: 0;
    }

    .focus-area {
        margin-top: 2rem;
    }
    
    .sub-section-title {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-primary);
        margin: 0 0 1rem 0;
    }

    .focus-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .focus-list li {
        font-size: 0.95rem;
        color: var(--text-secondary);
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        line-height: 1.5;
    }
    .focus-list li::before {
        content: "—";
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ───────── EXPERIENCE TIMELINE ───────── */
    .timeline-container {
        position: relative;
        padding-left: 2rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .timeline-axis {
        position: absolute;
        left: 6px;
        top: 8px;
        bottom: 0;
        width: 1px;
        background-color: var(--border-subtle);
    }

    .timeline-node {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .node-dot {
        position: absolute;
        left: -2rem;
        top: 6px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background-color: var(--bg-main);
        border: 2px solid var(--border-subtle);
        z-index: 2;
        transition: border-color 0.2s ease;
    }
    
    .timeline-node:hover .node-dot {
        border-color: var(--text-primary);
    }

    .node-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .node-header {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .role-company {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .role {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .company {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .location {
        font-weight: 500;
        color: var(--text-secondary);
    }

    .period {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .node-details {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .highlights {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .highlights li {
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--text-secondary);
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }
    .highlights li::before {
        content: "▹";
        color: var(--text-secondary);
        font-weight: 700;
    }

    /* ───────── TECH BADGES ───────── */
    .tech-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.25rem;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 600;
        color: #ffffff;
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    /* ───────── SKILLS GRID ───────── */
    .skills-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    .capability-card {
        background-color: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .category-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .skill-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .skill-pill {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
        background-color: var(--bg-main);
        border: 1px solid var(--border-subtle);
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        transition: color 0.2s ease, border-color 0.2s ease;
    }
    
    .skill-pill:hover {
        color: var(--text-primary);
        border-color: var(--text-secondary);
    }

    /* ───────── CTA ───────── */
    .profile-cta {
        margin-top: 2rem;
        margin-bottom: 2rem;
    }

    .cta-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
        text-decoration: none;
        padding: 0.75rem 0;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease;
    }

    .cta-link:hover {
        border-bottom-color: var(--text-primary);
    }

    /* ───────── EMPTY STATE ───────── */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        border: 1px dashed var(--border-subtle);
        border-radius: 12px;
        color: var(--text-secondary);
    }

    /* ───────── RESPONSIVE ───────── */
    @media (min-width: 768px) {
        .skills-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .node-header {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
        }

        .period {
            text-align: right;
            min-width: 150px;
        }
    }

    @media (max-width: 767px) {
        .timeline-container {
            padding-left: 1rem;
        }
        .timeline-axis {
            left: 0px;
            display: none; /* Simplify timeline on mobile */
        }
        .node-dot {
            display: none;
        }
        .timeline-node {
            border-left: 2px solid var(--border-subtle);
            padding-left: 1rem;
        }
        .timeline-node::before {
            content: "";
            position: absolute;
            left: -5px;
            top: 8px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--bg-surface);
            border: 2px solid var(--border-subtle);
            transition: all 0.2s ease;
        }
        .timeline-node:hover::before {
            border-color: var(--text-primary);
        }
        .timeline-node:hover {
            border-color: var(--text-primary);
        }
        .hidden-mobile {
            display: none;
        }
    }
</style>
