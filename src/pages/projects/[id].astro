---
import AppLayout from '../../layouts/AppLayout.astro';
import { projects, techBadgeColors } from '../../data/projects';
import ReSubsIcon from '../../components/projects/icons/ReSubsIcon.astro';
import MomentalIcon from '../../components/projects/icons/MomentalIcon.astro';
import AnalyticsIcon from '../../components/projects/icons/AnalyticsIcon.astro';

export function getStaticPaths() {
  const paths = projects.map(p => ({
    params: { id: p.id },
    props: { project: p },
  }));
  
  // Static fallback route for dynamic Firebase projects
  paths.push({
    params: { id: '[id]' },
    props: { project: null },
  });
  
  return paths;
}

const { project } = Astro.props;

// Derive fallback and color from existing logic
let derivedFallback = '';
let containerBg = 'var(--bg-main)';
let staticTitle = 'Loading...';
let staticCategory = '';
let staticDescription = '';
let staticTechStack: string[] = [];

if (project) {
  derivedFallback = project.fallbackText || project.title.substring(0, 2).toUpperCase();
  containerBg = project.brandColor || 'var(--bg-main)';
  staticTitle = project.title;
  staticCategory = project.category;
  staticDescription = project.description;
  staticTechStack = project.techStack || [];
}
---

<AppLayout title={`${staticTitle} | SATPAL`} activeNav="projects">
  <div class="project-detail-container">
    <a href="/projects" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Projects
    </a>

    <header class="detail-header">
      <div class="header-main">
        <div class="detail-icon" id="pd-icon" style={`background-color: ${containerBg}; color: ${project?.id === 'streamguide' ? '#000000' : '#ffffff'}; font-weight: ${project?.id === 'streamguide' ? '900' : '700'}`}>
          {project?.iconImage ? (
            <img src={project.iconImage} alt={`${staticTitle} logo`} class="detail-img-icon" />
          ) : project?.icon === 'resubs' ? (
            <ReSubsIcon />
          ) : project?.icon === 'momental' ? (
            <MomentalIcon />
          ) : project?.icon === 'analytics' ? (
            <AnalyticsIcon />
          ) : (
            <span>{derivedFallback}</span>
          )}
        </div>
        <div class="title-block">
          <h1 class="project-title" id="pd-title">{staticTitle}</h1>
          <span class="project-category" id="pd-category">{staticCategory}</span>
        </div>
      </div>

      <div class="header-actions" id="pd-actions">
        {project?.demoUrl && (
          <a href={project.demoUrl} class="action-btn demo-btn" target="_blank" rel="noopener noreferrer">
            Live Demo
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
        {project?.githubUrl && (
          <a href={project.githubUrl} class="action-btn github-btn" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
        )}
      </div>
    </header>

    <hr class="section-divider" />

    <section class="project-content">
      <div class="intro-block">
        <p class="project-intro" id="pd-desc">{staticDescription}</p>
        
        <div class="tech-stack-container">
          <h3 class="subsection-title">Technologies</h3>
          <div class="tech-badges" id="pd-tech">
            {staticTechStack.map((tech) => (
              <span
                class="badge"
                style={`background-color: ${techBadgeColors[tech] || '#6B7280'}`}
              >
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="structural-area content-area">
        <h3 class="placeholder-title">Overview</h3>
        <div class="placeholder-box">
          <p>Detailed project content, case study, and markdown body will be rendered here.</p>
        </div>
      </div>

      <div class="structural-area screenshots-area">
        <h3 class="placeholder-title">Screenshots</h3>
        <div class="placeholder-box">
          <p>Project screenshots and visual assets will be rendered here.</p>
        </div>
      </div>
    </section>
  </div>
</AppLayout>

<script>
  import { getProjectById } from '../../lib/portfolio-data';
  import { techBadgeColors } from '../../data/projects';

  async function loadFirebaseProject() {
    try {
      // Extract project ID from the URL path.
      const pathSegments = window.location.pathname.split('/').filter(Boolean);
      const projectId = pathSegments[pathSegments.length - 1];
      
      const p = await getProjectById(projectId);
      if (!p || !p.published) {
        // Show not found state by injecting a simple error message into the container
        const container = document.querySelector('.project-detail-container');
        if (container) {
          container.innerHTML = `
            <div style="text-align: center; padding: 5rem 1rem;">
              <h1 style="font-size: 3rem; margin-bottom: 1rem; color: var(--text-primary);">Project Not Found</h1>
              <p style="color: var(--text-secondary); margin-bottom: 2rem;">The project you are looking for does not exist or has been unpublished.</p>
              <a href="/projects" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--text-primary); color: var(--bg-surface); text-decoration: none; border-radius: 8px; font-weight: 600;">Return to Projects</a>
            </div>
          `;
          document.title = 'Project Not Found | SATPAL';
        }
        return;
      }

      const titleEl = document.getElementById('pd-title');
      const catEl = document.getElementById('pd-category');
      const descEl = document.getElementById('pd-desc');
      const techEl = document.getElementById('pd-tech');
      const iconEl = document.getElementById('pd-icon');
      const actionsEl = document.getElementById('pd-actions');

      if (titleEl) {
        titleEl.textContent = p.title;
        document.title = `${p.title} | SATPAL`;
      }
      if (catEl) catEl.textContent = p.category;
      if (descEl) descEl.textContent = p.description;

      if (techEl && p.techStack) {
        techEl.innerHTML = p.techStack.map(tech => 
          `<span class="badge" style="background-color: ${techBadgeColors[tech] || '#6B7280'}">${tech}</span>`
        ).join('');
      }

      if (iconEl) {
        const bg = p.brandColor || 'var(--bg-main)';
        iconEl.style.backgroundColor = bg;
        iconEl.style.color = '#ffffff';
        iconEl.style.fontWeight = '700';
        
        const fallback = p.fallbackText || p.title.substring(0, 2).toUpperCase();
        if (p.iconImage) {
          iconEl.innerHTML = `<img src="${p.iconImage}" alt="${p.title} logo" class="detail-img-icon" style="width: 100%; height: 100%; object-fit: cover; border-radius: 14px;" />`;
        } else {
          iconEl.innerHTML = `<span>${fallback}</span>`;
        }
      }

      if (actionsEl) {
        let actionsHtml = '';
        if (p.demoUrl) {
          actionsHtml += `
            <a href="${p.demoUrl}" class="action-btn demo-btn" target="_blank" rel="noopener noreferrer">
              Live Demo
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          `;
        }
        if (p.githubUrl) {
          actionsHtml += `
            <a href="${p.githubUrl}" class="action-btn github-btn" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          `;
        }
        actionsEl.innerHTML = actionsHtml;
      }

    } catch (err) {
      console.error("Failed to load Firebase project data", err);
      // Show not found state on error
      const container = document.querySelector('.project-detail-container');
      if (container) {
        container.innerHTML = `
          <div style="text-align: center; padding: 5rem 1rem;">
            <h1 style="font-size: 3rem; margin-bottom: 1rem; color: var(--text-primary);">Project Unavailable</h1>
            <p style="color: var(--text-secondary); margin-bottom: 2rem;">We couldn't load this project's details right now. Please try again later.</p>
            <a href="/projects" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--text-primary); color: var(--bg-surface); text-decoration: none; border-radius: 8px; font-weight: 600;">Return to Projects</a>
          </div>
        `;
        document.title = 'Project Unavailable | SATPAL';
      }
    }
  }

  loadFirebaseProject();
</script>

<style>
  .project-detail-container {
    max-width: 850px;
  }

  /* ───────── Back Link ───────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--text-primary);
  }

  /* ───────── Header ───────── */
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .header-main {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .detail-icon {
    width: 64px;
    height: 64px;
    min-width: 64px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }
  .detail-icon :global(svg) {
    width: 36px;
    height: 36px;
  }
  .detail-img-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
  }
  .title-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
  }
  .project-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.1;
    margin: 0;
  }
  .project-category {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-blue);
    background-color: var(--accent-blue-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }

  /* ───────── Actions ───────── */
  .header-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    flex: 1; /* Stretch on mobile */
  }
  .demo-btn {
    background-color: var(--text-primary);
    color: var(--bg-surface);
    border: 1px solid var(--text-primary);
  }
  .demo-btn:hover {
    opacity: 0.9;
  }
  .github-btn {
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }
  .github-btn:hover {
    background-color: var(--border-subtle);
  }

  /* ───────── Divider ───────── */
  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2rem 0;
  }

  /* ───────── Content ───────── */
  .project-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .intro-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .project-intro {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }
  
  /* Tech Stack */
  .tech-stack-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .subsection-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: #ffffff;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    line-height: 1.5;
  }

  /* ───────── Structural Areas ───────── */
  .structural-area {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .placeholder-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .placeholder-box {
    border: 1px dashed var(--border-subtle);
    border-radius: 12px;
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--bg-surface);
  }
  .placeholder-box p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  /* ───────── Tablet (768px+) ───────── */
  @media (min-width: 768px) {
    .detail-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }
    .action-btn {
      flex: 0 1 auto; /* Don't stretch on tablet/desktop */
    }
  }
</style>
