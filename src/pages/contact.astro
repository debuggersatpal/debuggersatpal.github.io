---
import AppLayout from "../layouts/AppLayout.astro";

// TEMPORARY STRUCTURAL DEMO DATA
// Provides a visual skeleton while Firebase loads.
const demoLinks = [
    { platform: "skeleton", url: "#" },
    { platform: "skeleton", url: "#" },
    { platform: "skeleton", url: "#" }
];
---

<AppLayout 
  title="Contact | SATPAL" 
  description="Get in touch. Find my email and social media links."
  activeNav="contact"
>
	<div class="contact-container">
        <!-- HEADER / INTRO -->
        <header class="contact-header">
            <h1 class="page-title hidden-visually">Contact</h1>
            <p class="intro-text">
                I'm always open to discussing new projects, creative ideas, or opportunities to be part of your visions.
            </p>
        </header>

        <section class="contact-content">
            <!-- EMAIL CARD -->
            <div class="primary-contact" id="primary-contact">
                <button class="email-interaction-card" id="copy-email-btn" aria-label="Copy email address" aria-live="polite">
                    <div class="email-card-content">
                        <span class="email-label">Email me at</span>
                        <span class="email-address" id="contact-email-text">
                            <span class="skeleton" style="width: 250px; display: inline-block;">&nbsp;</span>
                        </span>
                    </div>
                    <div class="email-card-action">
                        <span class="copy-feedback" id="copy-feedback">Copy</span>
                        <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                    </div>
                </button>
            </div>

            <!-- SOCIAL LINKS -->
            <div class="social-contact" id="social-contact">
                <h2 class="section-title">Elsewhere</h2>
                <div class="social-grid" id="social-grid">
                    {demoLinks.map(() => (
                        <div class="social-pill skeleton-pill" style="border-color: transparent;">
                            <span class="skeleton" style="width: 80px;"></span>
                        </div>
                    ))}
                </div>
            </div>
            
            <div id="contact-empty-state" class="empty-state" style="display: none;">
                <p>Contact information coming soon.</p>
            </div>
        </section>
    </div>
</AppLayout>

<script>
  import { getContact } from "../lib/portfolio-data";

  async function loadContact() {
    const pContact = document.getElementById('primary-contact');
    const copyBtn = document.getElementById('copy-email-btn');
    const emailText = document.getElementById('contact-email-text');
    const copyFeedback = document.getElementById('copy-feedback');
    const sContact = document.getElementById('social-contact');
    const sGrid = document.getElementById('social-grid');
    const emptyState = document.getElementById('contact-empty-state');

    try {
      const data = await getContact();
      
      if (!data) {
        if (pContact) pContact.style.display = 'none';
        if (sContact) sContact.style.display = 'none';
        if (emptyState) {
          emptyState.style.display = 'block';
          emptyState.innerHTML = '<p>Contact information coming soon.</p>';
        }
        return;
      }

      let hasContent = false;

      // Handle Email
      if (data.email && emailText && pContact && copyBtn) {
        emailText.textContent = data.email;
        emailText.classList.remove('skeleton');
        pContact.style.display = 'block';
        hasContent = true;
        
        // Clean up listeners
        const newCopyBtn = copyBtn.cloneNode(true) as HTMLElement;
        if (copyBtn.parentNode) {
          copyBtn.parentNode.replaceChild(newCopyBtn, copyBtn);
        }
        
        const newFeedback = newCopyBtn.querySelector('.copy-feedback');

        newCopyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(data.email);
            newCopyBtn.classList.add('copied');
            if (newFeedback) newFeedback.textContent = 'Copied!';
            
            setTimeout(() => {
              newCopyBtn.classList.remove('copied');
              if (newFeedback) newFeedback.textContent = 'Copy';
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      } else {
        if (pContact) pContact.style.display = 'none';
      }

      // Handle Socials
      if (data.socials && Array.isArray(data.socials) && data.socials.length > 0) {
        if (sGrid && sContact) {
          sGrid.innerHTML = data.socials.map((s: any) => `
            <a href="${s.url}" class="social-pill" target="_blank" rel="noopener noreferrer">
              <span class="platform-name">${s.platform}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          `).join('');
          sContact.style.display = 'block';
          hasContent = true;
        }
      } else {
        if (sContact) sContact.style.display = 'none';
      }
      
      if (!hasContent && emptyState) {
        emptyState.style.display = 'block';
        emptyState.innerHTML = '<p>Contact information coming soon.</p>';
      }
    } catch (err) {
      console.error("Failed to load Firebase contact data", err);
      if (pContact) pContact.style.display = 'none';
      if (sContact) sContact.style.display = 'none';
      if (emptyState) {
        emptyState.style.display = 'block';
        emptyState.innerHTML = '<p>Failed to load contact data. Please try again later.</p>';
      }
    }
  }

  document.addEventListener('astro:page-load', () => {
    loadContact();
  });
</script>

<style>
    .contact-container {
        max-width: 650px;
    }

    .hidden-visually {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ───────── HEADER ───────── */
    .contact-header {
        margin-bottom: 3.5rem;
    }

    .intro-text {
        font-size: 1.25rem;
        line-height: 1.6;
        font-weight: 500;
        color: var(--text-primary);
        margin: 0;
    }

    /* ───────── CONTENT ───────── */
    .contact-content {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .section-title {
        font-size: 1.05rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-primary);
        margin: 0 0 1.25rem 0;
    }

    /* ───────── EMAIL CARD ───────── */
    .email-interaction-card {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        padding: 2.5rem 2rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
        outline: none;
    }

    .email-interaction-card:hover, .email-interaction-card:focus-visible {
        border-color: var(--text-secondary);
        transform: translateY(-2px);
    }

    .email-interaction-card.copied {
        background-color: var(--accent-blue-bg);
        border-color: var(--accent-blue);
    }

    .email-card-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .email-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .email-address {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        word-break: break-all;
    }

    .email-interaction-card.copied .email-address,
    .email-interaction-card.copied .email-label {
        color: var(--accent-blue);
    }

    .email-card-action {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        transition: color 0.2s ease;
    }

    .email-interaction-card:hover .email-card-action {
        color: var(--text-primary);
    }

    .email-interaction-card.copied .email-card-action {
        color: var(--accent-blue);
    }

    .copy-feedback {
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* ───────── SOCIAL GRID ───────── */
    .social-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .social-pill {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: transparent;
        border: 1px solid var(--border-subtle);
        padding: 1.25rem 1.5rem;
        border-radius: 12px;
        text-decoration: none;
        color: var(--text-primary);
        transition: all 0.2s ease;
        outline: none;
        min-height: 48px;
    }

    .social-pill:hover, .social-pill:focus-visible {
        background-color: var(--bg-surface);
        border-color: var(--text-secondary);
    }

    .platform-name {
        font-size: 1.05rem;
        font-weight: 600;
    }

    .external-icon {
        color: var(--text-secondary);
        transition: color 0.2s ease;
    }

    .social-pill:hover .external-icon {
        color: var(--text-primary);
    }

    /* ───────── EMPTY STATE ───────── */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        border: 1px dashed var(--border-subtle);
        border-radius: 12px;
        color: var(--text-secondary);
    }

    /* ───────── RESPONSIVE ───────── */
    @media (min-width: 640px) {
        .social-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 639px) {
        .email-interaction-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
            padding: 2rem 1.5rem;
        }
        
        .email-card-action {
            flex-direction: row;
            align-self: flex-start;
        }

        .email-address {
            font-size: 1.5rem;
        }
    }
</style>
