---
import AppLayout from "../layouts/AppLayout.astro";

// TEMPORARY STRUCTURAL DEMO DATA
// To be replaced with actual skills data later.
const demoSkills = [
    {
        category: "[Category Placeholder 1]",
        items: [
            "[Skill Placeholder]", 
            "[Skill Placeholder]", 
            "[Skill Placeholder]", 
            "[Skill Placeholder]"
        ]
    },
    {
        category: "[Category Placeholder 2]",
        items: [
            "[Skill Placeholder]", 
            "[Skill Placeholder]", 
            "[Skill Placeholder]"
        ]
    },
    {
        category: "[Category Placeholder 3]",
        items: [
            "[Skill Placeholder]", 
            "[Skill Placeholder]", 
            "[Skill Placeholder]", 
            "[Skill Placeholder]", 
            "[Skill Placeholder]"
        ]
    }
];
---

<AppLayout 
  title="Skills | SATPAL" 
  description="Technical skills, programming languages, tools, and areas of expertise."
  activeNav="skills"
>
	<div class="skills-container">
        <header class="page-header">
            <h1 class="page-title">Skills</h1>
            <p class="page-subtitle">Technologies and tools I work with.</p>
        </header>

        <hr class="section-divider" />

        <div class="skills-list" id="skills-list">
            {demoSkills.map((section) => (
                <section class="skill-category">
                    <h2 class="category-title">{section.category}</h2>
                    <ul class="skill-items">
                        {section.items.map(item => (
                            <li class="skill-pill">{item}</li>
                        ))}
                    </ul>
                </section>
            ))}
        </div>
    </div>
</AppLayout>

<script>
  import { getPublishedSkills } from "../lib/portfolio-data";

  async function loadSkills() {
    try {
      const skillsData = await getPublishedSkills();
      if (!skillsData || skillsData.length === 0) return;

      const list = document.getElementById('skills-list');
      if (!list) return;

      let html = '';
      skillsData.forEach(section => {
        let itemsHtml = '';
        if (section.skills && Array.isArray(section.skills)) {
          section.skills.forEach((item: string) => {
            itemsHtml += `<li class="skill-pill">${item}</li>`;
          });
        }

        html += `
          <section class="skill-category">
              <h2 class="category-title">${section.category}</h2>
              <ul class="skill-items">
                  ${itemsHtml}
              </ul>
          </section>
        `;
      });

      list.innerHTML = html;
    } catch (err) {
      console.error("Failed to load Firebase skills", err);
    }
  }

  loadSkills();
</script>

<style>
    .skills-container {
        max-width: 800px;
    }

    /* ───────── Page Header ───────── */
    .page-header {
        margin-bottom: 1.25rem;
    }
    
    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.35rem 0;
        line-height: 1.1;
    }
    
    .page-subtitle {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin: 0;
    }

    /* ───────── Divider ───────── */
    .section-divider {
        border: none;
        border-top: 1px solid var(--border-subtle);
        margin: 2rem 0;
    }

    /* ───────── Skills List ───────── */
    .skills-list {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    .skill-category {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .category-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .skill-items {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .skill-pill {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-primary);
        background-color: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.4rem 1rem;
        border-radius: 8px;
        white-space: nowrap;
        transition: border-color 0.2s ease;
    }

    .skill-pill:hover {
        border-color: var(--text-secondary);
    }
</style>
