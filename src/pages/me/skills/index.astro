---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Skills | Portfolio Management" activeNav="skills">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Skills</h1>
        <p class="page-subtitle">Manage skill categories and entries</p>
      </div>
      <div class="header-actions">
        <a href="/me/skills/edit" class="primary-btn">Add Category</a>
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <div class="list-container" id="skills-list">
      <p class="loading-text">Loading skills...</p>
    </div>
  </div>
</MeLayout>

<style>
  .cms-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .cms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .primary-btn {
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .primary-btn:hover {
    opacity: 0.9;
  }

  .secondary-btn {
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .secondary-btn:hover {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1.5rem 0 2rem 0;
  }

  .loading-text, .empty-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

<style>
  .list-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .loading-state, .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: 12px;
  }

  .loading-state-text, .empty-state-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .empty-state-sub {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--text-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  :global(.list-item) {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    border-radius: 12px;
    gap: 1.25rem;
  }

  :global(.item-content) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  :global(.item-header) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  :global(.item-title) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  :global(.item-meta-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  :global(.meta-dot) {
    opacity: 0.5;
  }

  :global(.item-status) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  :global(.item-status::before) {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-secondary);
  }

  :global(.item-status.published) {
    color: var(--text-primary);
  }

  :global(.item-status.published::before) {
    background-color: #10b981;
  }

  :global(.item-actions) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  :global(.order-badge) {
    background-color: var(--bg-main);
    color: var(--text-secondary);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    :global(.list-item) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    :global(.item-actions) {
      flex-direction: column;
      align-items: stretch;
      width: 140px;
    }
    :global(.order-badge) {
      margin-right: 0;
      text-align: center;
      margin-bottom: 0.25rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.item-actions) {
      flex-direction: row;
      align-items: center;
      width: auto;
    }
    :global(.order-badge) {
      margin-right: 1rem;
      margin-bottom: 0;
    }
  }
</style>

<script>
import { db } from '../../../lib/firebase';
import { ref, onValue, remove } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {

  if ((window as any).__skillsUnsubscribe) {
    (window as any).__skillsUnsubscribe();
    (window as any).__skillsUnsubscribe = null;
  }

  const listEl = document.getElementById('skills-list');
  if (!listEl) return;

  const skillsRef = ref(db, 'skills');

  const unsubscribe = onValue(skillsRef, (snapshot) => {
    
    if (!snapshot.exists()) {
      listEl.innerHTML = `
        <div class="empty-state">
          <h3 class="empty-state-text">No skill categories exist</h3>
          <p class="empty-state-sub">Add your first category to showcase your expertise.</p>
          <a href="/me/skills/edit" class="primary-btn">Add Skill Category</a>
        </div>
      `;
      return;
    }

    const categories: any[] = [];
    snapshot.forEach((child) => {
      categories.push({ dbKey: child.key, ...child.val() });
    });

    // Sort by order ascending
    categories.sort((a, b) => (a.order || 0) - (b.order || 0));

    let html = '';
    categories.forEach(c => {
      const skillsCount = c.skills && Array.isArray(c.skills) ? c.skills.length : 0;
      const statusClass = c.published ? 'published' : 'draft';
      const statusText = c.published ? 'Published' : 'Draft';

      html += `
        <div class="list-item">
          <div class="item-content">
            <div class="item-header">
              <h3 class="item-title">${c.category || 'Untitled Category'}</h3>
            </div>
            <div class="item-meta-row">
              <span class="item-status ${statusClass}">${statusText}</span>
              <span class="meta-dot">&bull;</span>
              <span>${skillsCount} skills</span>
            </div>
          </div>
          <div class="item-actions">
            <span class="order-badge">Order: ${c.order || 0}</span>
            <a href="/me/skills/edit?id=${c.dbKey}" class="action-btn">Edit</a>
            <button class="action-btn delete-btn" data-id="${c.dbKey}">Delete</button>
          </div>
        </div>
      `;
    });

    listEl.innerHTML = html;

    // Attach delete listeners
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (evt) => {
        const id = (evt.target as HTMLButtonElement).dataset.id;
        if (id && confirm('Are you sure you want to delete this skill category? This cannot be undone.')) {
          try {
            await remove(ref(db, `skills/${id}`));
          } catch (err) {
            console.error('Failed to delete category:', err);
            alert('Failed to delete category.');
          }
        }
      });
    });
  });

  (window as any).__skillsUnsubscribe = unsubscribe;

  document.addEventListener('astro:before-swap', () => {
    if ((window as any).__skillsUnsubscribe) {
      (window as any).__skillsUnsubscribe();
      (window as any).__skillsUnsubscribe = null;
    }
  }, { once: true });

  });
</script>
