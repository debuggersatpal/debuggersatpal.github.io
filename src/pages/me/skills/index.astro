---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Skills | Portfolio Management" activeNav="skills">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Skills</h1>
        <p class="page-subtitle">Manage skill categories and entries</p>
      </div>
      <div class="header-actions">
        <a href="/me/skills/edit" class="primary-btn">Add Category</a>
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <div class="list-container" id="skills-list">
      <p class="loading-text">Loading skills...</p>
    </div>
  </div>
</MeLayout>

<style>
  .cms-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .cms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .primary-btn {
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .primary-btn:hover {
    opacity: 0.9;
  }

  .secondary-btn {
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .secondary-btn:hover {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1.5rem 0 2rem 0;
  }

  .loading-text, .empty-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .list-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.list-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
  }

  :global(.item-info) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  :global(.item-title) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  :global(.item-meta) {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  :global(.item-status) {
    width: 120px;
  }

  :global(.status-badge) {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
  }

  :global(.status-badge.published) {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.2);
  }

  :global(.status-badge.draft) {
    background-color: var(--bg-main);
    color: var(--text-secondary);
  }

  :global(.item-actions) {
    display: flex;
    gap: 0.75rem;
  }

  :global(.action-btn) {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  :global(.action-btn:hover) {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  :global(.delete-btn:hover) {
    color: #ef4444;
    border-color: #ef4444;
  }
</style>

<script>
import { db } from '../../../lib/firebase';
import { ref, onValue, remove } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {
  
  

  if ((window as any).__skillsUnsubscribe) {
    (window as any).__skillsUnsubscribe();
    (window as any).__skillsUnsubscribe = null;
  }

  const listEl = document.getElementById('skills-list');
  if (!listEl) return;

  const skillsRef = ref(db, 'skills');

  (window as any).__skillsUnsubscribe = onValue(skillsRef, (snapshot) => {
    
    if (!snapshot.exists()) {
      listEl.innerHTML = '<p class="empty-text">No skill categories found.</p>';
      return;
    }

    const categories: any[] = [];
    snapshot.forEach((child) => {
      categories.push({ dbKey: child.key, ...child.val() });
    });

    // Sort by order ascending
    categories.sort((a, b) => (a.order || 0) - (b.order || 0));

    let html = '';
    categories.forEach(c => {
      const skillsCount = c.skills && Array.isArray(c.skills) ? c.skills.length : 0;
      html += `
        <div class="list-item">
          <div class="item-info">
            <h3 class="item-title">${c.category || 'Untitled Category'}</h3>
            <span class="item-meta">${skillsCount} skills • Order: ${c.order || 0}</span>
          </div>
          <div class="item-status">
            <span class="status-badge ${c.published ? 'published' : 'draft'}">${c.published ? 'Published' : 'Draft'}</span>
          </div>
          <div class="item-actions">
            <a href="/me/skills/edit?id=${c.dbKey}" class="action-btn">Edit</a>
            <button class="action-btn delete-btn" data-id="${c.dbKey}">Delete</button>
          </div>
        </div>
      `;
    });

    listEl.innerHTML = html;

    // Attach delete listeners
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (evt) => {
        const id = (evt.target as HTMLButtonElement).dataset.id;
        if (id && confirm('Are you sure you want to delete this skill category? This cannot be undone.')) {
          try {
            await remove(ref(db, `skills/${id}`));
          } catch (err) {
            console.error('Failed to delete category:', err);
            alert('Failed to delete category.');
          }
        }
      });
    });
  });
  });
</script>
