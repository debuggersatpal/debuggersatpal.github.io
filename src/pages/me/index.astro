---
import MeLayout from '../../layouts/MeLayout.astro';
---

<MeLayout title="Dashboard | Portfolio Management" activeNav="dashboard">
  <div class="cms-container">
    <header class="cms-header">
      <div class="header-content">
        <span class="workspace-badge">CMS Workspace</span>
        <h1 class="page-title">Portfolio</h1>
        <p class="page-subtitle">Manage your portfolio content and publishing state.</p>
      </div>
    </header>

    <hr class="section-divider" />

    <section class="dashboard-section">
      <h2 class="section-title">Overview</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-value" id="stat-projects">-</div>
          <div class="stat-label">Total Projects</div>
        </div>
        <div class="stat-item">
          <div class="stat-value" id="stat-published">-</div>
          <div class="stat-label">Published Projects</div>
        </div>
        <div class="stat-item">
          <div class="stat-value" id="stat-experience">-</div>
          <div class="stat-label">Experience Entries</div>
        </div>
        <div class="stat-item">
          <div class="stat-value" id="stat-skills">-</div>
          <div class="stat-label">Skill Categories</div>
        </div>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-header">
        <h2 class="section-title">Quick Actions</h2>
      </div>
      <div class="actions-grid">
        <a href="/me/projects/edit" class="action-card primary-action">
          <div class="action-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
          </div>
          <div class="action-content">
            <h3 class="action-title">New Project</h3>
            <p class="action-desc">Add a new project to your portfolio</p>
          </div>
        </a>
        <a href="/me/experience/edit" class="action-card secondary-action">
          <div class="action-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          </div>
          <div class="action-content">
            <h3 class="action-title">Add Experience</h3>
          </div>
        </a>
        <a href="/me/skills" class="action-card secondary-action">
          <div class="action-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16.1A5 5 0 0 1 5.9 20M2 12.05A9 9 0 0 1 9.95 20M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"></path><line x1="2" y1="20" x2="2.01" y2="20"></line></svg>
          </div>
          <div class="action-content">
            <h3 class="action-title">Manage Skills</h3>
          </div>
        </a>
        <a href="/me/about" class="action-card secondary-action">
          <div class="action-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div class="action-content">
            <h3 class="action-title">Edit About</h3>
          </div>
        </a>
        <a href="/me/contact" class="action-card secondary-action">
          <div class="action-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="action-content">
            <h3 class="action-title">Edit Contact</h3>
          </div>
        </a>
        <a href="/me/settings" class="action-card secondary-action">
          <div class="action-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </div>
          <div class="action-content">
            <h3 class="action-title">Settings</h3>
          </div>
        </a>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-header">
        <h2 class="section-title">Recent Projects</h2>
        <a href="/me/projects" class="view-all-link">View all</a>
      </div>
      <div id="recent-projects-list" class="recent-list">
        <div class="loading-state">
          <div class="spinner"></div>
          <span class="loading-state-text">Loading workspace...</span>
        </div>
      </div>
    </section>
  </div>
</MeLayout>

<style>
  .header-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .workspace-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    background-color: var(--accent-blue-bg);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .dashboard-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .view-all-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .view-all-link:hover {
    color: var(--text-primary);
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Quick Actions */
  .actions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .action-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .action-card:hover {
    background-color: var(--bg-surface);
    border-color: var(--text-secondary);
  }

  .primary-action {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    grid-column: 1 / -1;
  }

  .primary-action .action-icon {
    color: var(--text-primary);
  }

  .action-icon {
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .action-content {
    display: flex;
    flex-direction: column;
  }

  .action-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .action-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Recent Projects */
  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .loading-state, .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: 12px;
  }

  .loading-state-text, .empty-state-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .empty-state-sub {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--text-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
  }

  :global(.recent-project-item) {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
    gap: 0.75rem;
  }

  :global(.recent-project-item:hover) {
    border-color: var(--text-secondary);
  }

  :global(.recent-info) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  :global(.recent-title) {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  :global(.recent-meta) {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.meta-dot) {
    opacity: 0.5;
  }

  :global(.recent-status) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  :global(.recent-status::before) {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-secondary);
  }

  :global(.recent-status.published) {
    color: var(--text-primary);
  }

  :global(.recent-status.published::before) {
    background-color: #10b981;
  }

  :global(.recent-arrow) {
    color: var(--text-secondary);
    display: none;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
    .actions-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    :global(.recent-project-item) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    :global(.recent-arrow) {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .actions-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  import { db } from '../../lib/firebase';
  import { ref, get, query, orderByChild, limitToFirst } from 'firebase/database';

  async function loadDashboard() {
    // Only run if we are actually on the dashboard page
    if (!document.getElementById('stat-projects')) return;

    try {
      const [projectsSnap, expSnap, skillsSnap] = await Promise.all([
        get(ref(db, 'projects')),
        get(ref(db, 'experience')),
        get(ref(db, 'skills'))
      ]);

      let totalProjects = 0;
      let publishedProjects = 0;
      const projectsList: any[] = [];

      if (projectsSnap.exists()) {
        projectsSnap.forEach((child) => {
          totalProjects++;
          const p = { dbKey: child.key, ...child.val() };
          if (p.published) publishedProjects++;
          projectsList.push(p);
        });
      }

      let totalExp = 0;
      if (expSnap.exists()) {
        totalExp = Object.keys(expSnap.val()).length;
      }

      let totalSkills = 0;
      if (skillsSnap.exists()) {
        totalSkills = Object.keys(skillsSnap.val()).length;
      }

      // Update stats
      const elProj = document.getElementById('stat-projects');
      const elPub = document.getElementById('stat-published');
      const elExp = document.getElementById('stat-experience');
      const elSkills = document.getElementById('stat-skills');

      if (elProj) elProj.textContent = totalProjects.toString();
      if (elPub) elPub.textContent = publishedProjects.toString();
      if (elExp) elExp.textContent = totalExp.toString();
      if (elSkills) elSkills.textContent = totalSkills.toString();

      // Update recent projects list
      const listEl = document.getElementById('recent-projects-list');
      if (!listEl) return;
      
      if (projectsList.length === 0) {
        listEl.innerHTML = `
          <div class="empty-state">
            <h3 class="empty-state-text">No projects yet</h3>
            <p class="empty-state-sub">Create your first project to start building your portfolio.</p>
            <a href="/me/projects/edit" class="primary-btn">Create Project</a>
          </div>
        `;
      } else {
        // Sort by order, take top 3
        projectsList.sort((a, b) => (a.order || 0) - (b.order || 0));
        const recent = projectsList.slice(0, 3);
        
        let html = '';
        recent.forEach(p => {
          const statusClass = p.published ? 'published' : 'draft';
          const statusText = p.published ? 'Published' : 'Draft';
          const cat = p.category || 'Uncategorized';
          
          html += `
            <a href="/me/projects/edit?id=${p.dbKey}" class="recent-project-item">
              <div class="recent-info">
                <h4 class="recent-title">${p.title || 'Untitled'}</h4>
                <div class="recent-meta">
                  <span class="recent-status ${statusClass}">${statusText}</span>
                  <span class="meta-dot">&bull;</span>
                  <span>${cat}</span>
                </div>
              </div>
              <div class="recent-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
            </a>
          `;
        });
        listEl.innerHTML = html;
      }
    } catch (err) {
      console.error('Failed to load dashboard data:', err);
      // Fallback
      const listEl = document.getElementById('recent-projects-list');
      if (listEl) {
        listEl.innerHTML = `
          <div class="empty-state" style="border-color: #ef4444;">
            <p class="empty-state-text" style="color: #ef4444;">Failed to load workspace data.</p>
            <p class="empty-state-sub">Ensure you are authenticated and have permission.</p>
          </div>
        `;
      }
    }
  }

  document.addEventListener('astro:page-load', loadDashboard);
</script>
