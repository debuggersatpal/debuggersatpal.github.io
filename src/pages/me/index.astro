---
import MeLayout from '../../layouts/MeLayout.astro';
---

<MeLayout title="Dashboard | Portfolio Management" activeNav="dashboard">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Manage your portfolio content.</p>
      </div>
    </header>

    <hr class="section-divider" />

    <section class="dashboard-section">
      <h2 class="section-title">Overview</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value" id="stat-projects">-</div>
          <div class="stat-label">Total Projects</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="stat-published">-</div>
          <div class="stat-label">Published</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="stat-experience">-</div>
          <div class="stat-label">Experience Entries</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="stat-skills">-</div>
          <div class="stat-label">Skill Categories</div>
        </div>
      </div>
    </section>

    <section class="dashboard-section">
      <h2 class="section-title">Quick Actions</h2>
      <div class="actions-grid">
        <a href="/me/projects/edit" class="action-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
          Add Project
        </a>
        <a href="/me/experience/edit" class="action-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          Add Experience
        </a>
        <a href="/me/skills" class="action-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16.1A5 5 0 0 1 5.9 20M2 12.05A9 9 0 0 1 9.95 20M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"></path><line x1="2" y1="20" x2="2.01" y2="20"></line></svg>
          Manage Skills
        </a>
        <a href="/me/about" class="action-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Edit About
        </a>
        <a href="/me/contact" class="action-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          Edit Contact
        </a>
        <a href="/me/settings" class="action-card">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          Settings
        </a>
      </div>
    </section>

    <section class="dashboard-section">
      <h2 class="section-title">Recent Projects</h2>
      <div id="recent-projects-list" class="recent-list">
        <p class="loading-text">Loading...</p>
      </div>
    </section>
  </div>
</MeLayout>

<style>
  .cms-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .cms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1.5rem 0 2rem 0;
  }

  .dashboard-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .action-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    border-radius: 10px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .action-card:hover {
    border-color: var(--accent-blue);
    background-color: var(--accent-blue-bg);
    color: var(--accent-blue);
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .loading-text, .empty-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  :global(.recent-project-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  :global(.recent-project-item:hover) {
    border-color: var(--text-secondary);
  }

  :global(.recent-title) {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  
  :global(.recent-meta) {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .actions-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  import { db } from '../../lib/firebase';
  import { ref, get, query, orderByChild, limitToFirst } from 'firebase/database';

  async function loadDashboard() {
    // Only run if we are actually on the dashboard page
    if (!document.getElementById('stat-projects')) return;

    try {
      const [projectsSnap, expSnap, skillsSnap] = await Promise.all([
        get(ref(db, 'projects')),
        get(ref(db, 'experience')),
        get(ref(db, 'skills'))
      ]);

      let totalProjects = 0;
      let publishedProjects = 0;
      const projectsList: any[] = [];

      if (projectsSnap.exists()) {
        projectsSnap.forEach((child) => {
          totalProjects++;
          const p = { dbKey: child.key, ...child.val() };
          if (p.published) publishedProjects++;
          projectsList.push(p);
        });
      }

      let totalExp = 0;
      if (expSnap.exists()) {
        totalExp = Object.keys(expSnap.val()).length;
      }

      let totalSkills = 0;
      if (skillsSnap.exists()) {
        totalSkills = Object.keys(skillsSnap.val()).length;
      }

      // Update stats
      const elProj = document.getElementById('stat-projects');
      const elPub = document.getElementById('stat-published');
      const elExp = document.getElementById('stat-experience');
      const elSkills = document.getElementById('stat-skills');

      if (elProj) elProj.textContent = totalProjects.toString();
      if (elPub) elPub.textContent = publishedProjects.toString();
      if (elExp) elExp.textContent = totalExp.toString();
      if (elSkills) elSkills.textContent = totalSkills.toString();

      // Update recent projects list
      const listEl = document.getElementById('recent-projects-list');
    if (!listEl) return;
      if (listEl) {
        if (projectsList.length === 0) {
          listEl.innerHTML = '<p class="empty-text">No projects yet. <a href="/me/projects/edit" style="color: var(--accent-blue)">Create one</a>.</p>';
        } else {
          // Sort by order, take top 3
          projectsList.sort((a, b) => (a.order || 0) - (b.order || 0));
          const recent = projectsList.slice(0, 3);
          
          let html = '';
          recent.forEach(p => {
            html += `
              <a href="/me/projects/edit?id=${p.dbKey}" class="recent-project-item">
                <div>
                  <div class="recent-title">${p.title || 'Untitled'}</div>
                  <div class="recent-meta">${p.category || 'Uncategorized'}</div>
                </div>
                <div style="color: var(--text-secondary)">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </div>
              </a>
            `;
          });
          listEl.innerHTML = html;
        }
      }
    } catch (err) {
      console.error('Failed to load dashboard data:', err);
      // Fallback
      const listEl = document.getElementById('recent-projects-list');
      if (listEl) {
        listEl.innerHTML = '<p class="empty-text">Failed to load data. Please ensure you are authenticated and have permission.</p>';
      }
    }
  }

  document.addEventListener('astro:page-load', loadDashboard);
</script>
