---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Login | Portfolio Management">
  <div class="login-page">
    <div class="login-card">
      <h1 class="login-title">Portfolio Management</h1>
      <p class="login-subtitle">Private access only.</p>

      <form id="login-form" class="login-form">
        <div class="input-group">
          <label for="email">Email</label>
          <input type="email" id="email" required />
        </div>
        
        <div class="input-group">
          <label for="password">Password</label>
          <input type="password" id="password" required />
        </div>

        <div id="error-msg" class="error-msg"></div>

        <button type="submit" id="submit-btn" class="submit-btn">Sign In</button>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  .login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-main);
    padding: 1.5rem;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background-color: var(--bg-surface);
    padding: 2.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  .login-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.25rem 0;
  }

  .login-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0 0 2rem 0;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .input-group input {
    background-color: var(--bg-main);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .input-group input:focus {
    border-color: var(--accent-blue);
  }

  .error-msg {
    color: #ef4444;
    font-size: 0.85rem;
    font-weight: 500;
    min-height: 1.25rem;
  }

  .submit-btn {
    background-color: var(--text-primary);
    color: var(--bg-main);
    border: none;
    padding: 0.85rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
    margin-top: 0.5rem;
  }

  .submit-btn:hover {
    opacity: 0.9;
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  import { auth } from '../../lib/firebase';
  import { signInWithEmailAndPassword, onAuthStateChanged } from 'firebase/auth';

  // Reverse guard: if already logged in, redirect to dashboard
  onAuthStateChanged(auth, (user) => {
    if (user) {
      window.location.replace('/me');
    }
  });

  const form = document.getElementById('login-form') as HTMLFormElement;
  
  if (form) {
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      errorMsg.textContent = '';
      submitBtn.textContent = 'Signing In...';
      submitBtn.disabled = true;

      try {
        await signInWithEmailAndPassword(auth, emailInput.value, passwordInput.value);
        // Explicitly redirect on success to prevent continuous loading state
        window.location.assign('/me');
      } catch (error: any) {
        errorMsg.textContent = error.message || 'Invalid credentials.';
        submitBtn.textContent = 'Sign In';
        submitBtn.disabled = false;
      }
    });
  }
</script>
