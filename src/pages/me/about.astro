---
import MeLayout from '../../layouts/MeLayout.astro';
---

<MeLayout title="About Editor | Portfolio Management" activeNav="about">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">About</h1>
        <p class="page-subtitle">Manage your biography and focus areas</p>
      </div>
      <div class="header-actions">
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="about-form" class="editor-form">
      <div class="form-section">
        <h2 class="form-section-title">1. Introduction</h2>
        <div class="input-group">
          <label for="introduction">Introduction <span class="required-asterisk">*</span></label>
          <textarea id="introduction" rows="4" required placeholder="A short, impactful introductory paragraph..."></textarea>
          <span class="input-helper">This text appears at the top of your public About page.</span>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">2. Biography</h2>
        <div class="input-group">
          <label for="biography">Biography <span class="required-asterisk">*</span></label>
          <textarea id="biography" rows="12" required placeholder="Full biographical content. You can write multiple paragraphs here..."></textarea>
          <span class="input-helper">Write your full biography. Line breaks will be preserved.</span>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">3. Focus Areas</h2>
        <div class="input-group">
          <label for="focusAreas">Focus Areas</label>
          <textarea id="focusAreas" rows="6" placeholder="UI/UX Engineering&#10;Design Systems&#10;Performance Optimization"></textarea>
          <span class="input-helper">Enter one focus area per line. Empty lines will be ignored.</span>
        </div>
      </div>

      <div id="form-feedback" class="form-feedback"></div>

      <div class="form-actions">
        <div class="primary-actions">
          <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</MeLayout>

<style>
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--bg-surface);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .form-section {
      padding: 2rem;
    }
  }

  .form-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required-asterisk {
    color: #ef4444;
  }

  .input-helper {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .form-actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    margin-top: 1rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .form-actions {
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
    }
  }

  .primary-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .primary-actions {
      flex-direction: row;
    }
  }

  .form-feedback {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
  }

  .form-feedback.success {
    display: block;
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-feedback.error {
    display: block;
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
</style>

<script>
import { db } from '../../lib/firebase';
import { ref as dbRef, get, set } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {

  const form = document.getElementById('about-form') as HTMLFormElement;
  if (!form) return;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const feedbackEl = document.getElementById('form-feedback') as HTMLDivElement;
  
  function showFeedback(msg: string, type: 'success' | 'error') {
    feedbackEl.textContent = msg;
    feedbackEl.className = `form-feedback ${type}`;
    feedbackEl.style.display = 'block';
    setTimeout(() => {
      feedbackEl.style.display = 'none';
    }, 5000);
  }
  
  const introInput = document.getElementById('introduction') as HTMLTextAreaElement;
  const bioInput = document.getElementById('biography') as HTMLTextAreaElement;
  const focusAreasInput = document.getElementById('focusAreas') as HTMLTextAreaElement;

  // On page load, fetch existing /about
  get(dbRef(db, 'about')).then(snapshot => {
    if (snapshot.exists()) {
      const data = snapshot.val();
      introInput.value = data.introduction || '';
      bioInput.value = data.biography || '';
      if (data.focusAreas && Array.isArray(data.focusAreas)) {
        focusAreasInput.value = data.focusAreas.join('\n');
      }
    }
  }).catch(err => {
    console.error("Failed to load about data:", err);
    showFeedback("Failed to load about data.", "error");
  });

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const introVal = introInput.value.trim();
    const bioVal = bioInput.value.trim();
    const focusAreasArray = focusAreasInput.value
      .split('\n')
      .map(s => s.trim())
      .filter(Boolean); // removes empty lines

    // Validation
    if (!introVal) {
      showFeedback("Introduction is required.", "error");
      return;
    }
    if (!bioVal) {
      showFeedback("Biography is required.", "error");
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const aboutData = {
      introduction: introVal,
      biography: bioVal,
      focusAreas: focusAreasArray.length > 0 ? focusAreasArray : null
    };

    try {
      // Use set() directly on the single 'about' node
      await set(dbRef(db, 'about'), aboutData);
      
      showFeedback("About profile saved successfully!", "success");
      saveBtn.textContent = 'Save Changes';
      saveBtn.disabled = false;
      
    } catch (error) {
      console.error("Save error:", error);
      showFeedback("Error saving about profile. Check permissions.", "error");
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });
  });
</script>
