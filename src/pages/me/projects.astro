---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Projects Editor">
  <div class="cms-header">
    <h1>Projects (Drafts)</h1>
    <div class="cms-actions">
      <button id="btn-add" class="btn btn-primary">Add Project</button>
      <button id="btn-publish" class="btn">Publish to Live</button>
    </div>
  </div>
  
  <div id="status-message" class="status-message"></div>
  <div id="loading" class="loading">Loading drafts...</div>

  <div id="projects-list" style="display: flex; flex-direction: column; gap: var(--space-4);"></div>

  <template id="proj-template">
    <div class="cms-form" style="position: relative;">
      <button class="delete-btn" style="position: absolute; right: 1rem; top: 1rem; color: #dc2626; background: none; border: none; cursor: pointer; font-size: 0.875rem;">Delete</button>
      
      <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Project Setup</h3>
      <div class="field">
        <label>Slug (URL identifier)</label>
        <input type="text" class="f-slug" required />
      </div>
      <div class="field">
        <label>Title</label>
        <input type="text" class="f-title" required />
      </div>
      <div class="field">
        <label>Category</label>
        <input type="text" class="f-category" required />
      </div>
      <div class="field">
        <label>Thumbnail Media Reference</label>
        <input type="text" class="f-thumb" placeholder="/media/thumb.jpg" required />
      </div>
      <div class="field">
        <label>Order (lower comes first)</label>
        <input type="number" class="f-order" value="0" required />
      </div>

      <h3 style="font-size: 1.1rem; margin-top: 1rem; margin-bottom: 0.5rem;">Project Detail Content</h3>
      <div class="field">
        <label>Content (Markdown/HTML)</label>
        <textarea class="f-content" rows="6"></textarea>
      </div>
      <div class="field">
        <label>Tech Stack (Comma separated)</label>
        <input type="text" class="f-tech" placeholder="Astro, Firebase, TypeScript" />
      </div>
      <div class="field">
        <label>Demo URL (Optional)</label>
        <input type="url" class="f-demo" placeholder="https://example.com" />
      </div>
      <div class="field">
        <label>GitHub URL (Optional)</label>
        <input type="url" class="f-github" placeholder="https://github.com/..." />
      </div>
      
      <div class="cms-actions" style="margin-top: 1rem;">
        <button class="btn btn-primary save-proj-btn">Save Project Draft</button>
      </div>
    </div>
  </template>

  <script>
    import { CmsService } from '../../lib/admin/cms-service';
    
    const list = document.getElementById('projects-list');
    const template = document.getElementById('proj-template') as HTMLTemplateElement;
    const loading = document.getElementById('loading');
    const status = document.getElementById('status-message');

    function showStatus(msg: string, isError = false) {
      if (!status) return;
      status.textContent = msg;
      status.className = 'status-message ' + (isError ? 'error' : 'success');
      setTimeout(() => status.textContent = '', 5000);
    }

    function createFormNode(summary?: any, detail?: any) {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const formEl = node.querySelector('.cms-form') as HTMLElement;
      
      const inputs = {
        slug: node.querySelector('.f-slug') as HTMLInputElement,
        title: node.querySelector('.f-title') as HTMLInputElement,
        category: node.querySelector('.f-category') as HTMLInputElement,
        thumb: node.querySelector('.f-thumb') as HTMLInputElement,
        order: node.querySelector('.f-order') as HTMLInputElement,
        content: node.querySelector('.f-content') as HTMLTextAreaElement,
        tech: node.querySelector('.f-tech') as HTMLInputElement,
        demo: node.querySelector('.f-demo') as HTMLInputElement,
        github: node.querySelector('.f-github') as HTMLInputElement
      };

      if (summary) {
        inputs.slug.value = summary.slug;
        inputs.slug.disabled = true;
        inputs.title.value = summary.title;
        inputs.category.value = summary.category;
        inputs.thumb.value = summary.thumbnail;
        inputs.order.value = summary.order;
      }

      if (detail) {
        inputs.content.value = detail.content || '';
        inputs.tech.value = (detail.techStack || []).join(', ');
        inputs.demo.value = detail.demoUrl || '';
        inputs.github.value = detail.githubUrl || '';
      }

      node.querySelector('.delete-btn')?.addEventListener('click', async () => {
        if (!summary) {
          formEl.remove();
          return;
        }
        if (confirm('Delete this project draft?')) {
          await CmsService.deleteProjectDraft(summary.slug);
          formEl.remove();
          showStatus('Project draft deleted.');
        }
      });

      node.querySelector('.save-proj-btn')?.addEventListener('click', async () => {
        const slug = inputs.slug.value.trim();
        if (!slug || !inputs.title.value) {
          showStatus('Slug and Title are required', true);
          return;
        }
        
        try {
          await CmsService.saveProjectDraft(slug, 
            {
              title: inputs.title.value,
              category: inputs.category.value,
              thumbnail: inputs.thumb.value,
              order: parseInt(inputs.order.value) || 0
            },
            {
              content: inputs.content.value,
              techStack: inputs.tech.value.split(',').map((s: string) => s.trim()).filter(Boolean),
              gallery: [],
              demoUrl: inputs.demo.value.trim() || undefined,
              githubUrl: inputs.github.value.trim() || undefined
            }
          );
          inputs.slug.disabled = true;
          showStatus(`Saved project draft: ${slug}`);
        } catch (err: any) {
          showStatus('Error saving: ' + err.message, true);
        }
      });

      return formEl;
    }

    async function init() {
      try {
        const summaries = await CmsService.getProjectDrafts();
        
        for (const s of summaries) {
          const detail = await CmsService.getProjectDetailDraft(s.slug);
          list?.appendChild(createFormNode(s, detail));
        }
        if (loading) loading.style.display = 'none';
      } catch (err: any) {
        showStatus('Failed to load drafts: ' + err.message, true);
      }
    }

    document.getElementById('btn-add')?.addEventListener('click', () => {
      list?.prepend(createFormNode());
    });

    document.getElementById('btn-publish')?.addEventListener('click', async () => {
      try {
        await CmsService.triggerServerPublish('projects');
      } catch (err: any) {
        showStatus(err.message, true);
      }
    });

    init();
  </script>
</AdminLayout>
