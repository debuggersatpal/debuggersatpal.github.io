---
import MeLayout from '../../layouts/MeLayout.astro';
---

<MeLayout title="Settings Editor | Portfolio Management" activeNav="settings">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Manage your portfolio site configuration</p>
      </div>
      <div class="header-actions">
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="settings-form" class="editor-form">
      <div class="input-group">
        <label for="siteTitle">Site Title *</label>
        <input type="text" id="siteTitle" required placeholder="e.g. Satpal | Portfolio" />
      </div>

      <div class="input-group">
        <label for="seoDescription">SEO Description</label>
        <textarea id="seoDescription" rows="4" placeholder="Brief description of the site for search engines..."></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Changes</button>
      </div>
    </form>
  </div>
</MeLayout>

<style>
  .cms-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .cms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .primary-btn {
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .primary-btn:hover {
    opacity: 0.9;
  }

  .primary-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .secondary-btn {
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .secondary-btn:hover {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1.5rem 0 2.5rem 0;
  }

  /* Form Styles */
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: var(--bg-surface);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .input-group input, .input-group textarea {
    background-color: var(--bg-main);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
  }
  
  .input-group textarea {
    resize: vertical;
  }

  .input-group input:focus, .input-group textarea:focus {
    border-color: var(--accent-blue);
  }

  .form-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }
</style>

<script>
import { db } from '../../lib/firebase';
import { ref as dbRef, get, set } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {
  
  

  const form = document.getElementById('settings-form') as HTMLFormElement;
    if (!form) return;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  
  const titleInput = document.getElementById('siteTitle') as HTMLInputElement;
  const seoInput = document.getElementById('seoDescription') as HTMLTextAreaElement;

  // On page load, fetch existing /settings
  get(dbRef(db, 'settings')).then(snapshot => {
    if (snapshot.exists()) {
      const data = snapshot.val();
      titleInput.value = data.siteTitle || '';
      seoInput.value = data.seoDescription || '';
    }
  }).catch(err => {
    console.error("Failed to load settings data:", err);
  });

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const titleVal = titleInput.value.trim();
    const seoVal = seoInput.value.trim();

    // Validation
    if (!titleVal) {
      alert("Site Title is required.");
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const settingsData = {
      siteTitle: titleVal,
      seoDescription: seoVal || null // remove if empty
    };

    try {
      // Use set() directly on the single 'settings' node
      await set(dbRef(db, 'settings'), settingsData);
      
      saveBtn.textContent = 'Saved!';
      setTimeout(() => {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }, 2000);
      
    } catch (error) {
      console.error("Save error:", error);
      alert('Error saving settings data. Check permissions.');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });
  });
</script>
