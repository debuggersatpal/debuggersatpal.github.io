---
import MeLayout from '../../layouts/MeLayout.astro';
---

<MeLayout title="Settings Editor | Portfolio Management" activeNav="settings">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Manage your portfolio site configuration</p>
      </div>
      <div class="header-actions">
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="settings-form" class="editor-form">
      <div class="form-section">
        <h2 class="form-section-title">1. Site Identity</h2>
        <div class="input-group">
          <label for="siteTitle">Site Title <span class="required-asterisk">*</span></label>
          <input type="text" id="siteTitle" required placeholder="e.g. Satpal | Portfolio" />
          <span class="input-helper">This appears in the browser tab and navigation header of your public portfolio.</span>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">2. SEO</h2>
        <div class="input-group">
          <label for="seoDescription">SEO Description</label>
          <textarea id="seoDescription" rows="4" placeholder="Brief description of the site for search engines..."></textarea>
          <span class="input-helper">This appears in search engine results and social media link previews.</span>
        </div>
      </div>

      <div id="form-feedback" class="form-feedback"></div>

      <div class="form-actions">
        <div class="primary-actions">
          <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</MeLayout>

<style>
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--bg-surface);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .form-section {
      padding: 2rem;
    }
  }

  .form-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required-asterisk {
    color: #ef4444;
  }

  .input-helper {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .form-actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    margin-top: 1rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .form-actions {
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
    }
  }

  .primary-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .primary-actions {
      flex-direction: row;
    }
  }

  .form-feedback {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
  }

  .form-feedback.success {
    display: block;
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-feedback.error {
    display: block;
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
</style>

<script>
import { db } from '../../lib/firebase';
import { ref as dbRef, get, set } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {

  const form = document.getElementById('settings-form') as HTMLFormElement;
  if (!form) return;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const feedbackEl = document.getElementById('form-feedback') as HTMLDivElement;
  
  function showFeedback(msg: string, type: 'success' | 'error') {
    feedbackEl.textContent = msg;
    feedbackEl.className = `form-feedback ${type}`;
    feedbackEl.style.display = 'block';
    setTimeout(() => {
      feedbackEl.style.display = 'none';
    }, 5000);
  }
  
  const titleInput = document.getElementById('siteTitle') as HTMLInputElement;
  const seoInput = document.getElementById('seoDescription') as HTMLTextAreaElement;

  // On page load, fetch existing /settings
  get(dbRef(db, 'settings')).then(snapshot => {
    if (snapshot.exists()) {
      const data = snapshot.val();
      titleInput.value = data.siteTitle || '';
      seoInput.value = data.seoDescription || '';
    }
  }).catch(err => {
    console.error("Failed to load settings data:", err);
    showFeedback("Failed to load settings data.", "error");
  });

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const titleVal = titleInput.value.trim();
    const seoVal = seoInput.value.trim();

    // Validation
    if (!titleVal) {
      showFeedback("Site Title is required.", "error");
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const settingsData = {
      siteTitle: titleVal,
      seoDescription: seoVal || null // remove if empty
    };

    try {
      // Use set() directly on the single 'settings' node
      await set(dbRef(db, 'settings'), settingsData);
      
      showFeedback("Settings saved successfully!", "success");
      saveBtn.textContent = 'Save Changes';
      saveBtn.disabled = false;
      
    } catch (error) {
      console.error("Save error:", error);
      showFeedback("Error saving settings data. Check permissions.", "error");
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });
  });
</script>
