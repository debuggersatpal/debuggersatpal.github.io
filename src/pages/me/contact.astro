---
import MeLayout from '../../layouts/MeLayout.astro';
---

<MeLayout title="Contact Editor | Portfolio Management" activeNav="contact">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Contact</h1>
        <p class="page-subtitle">Manage your contact information and social links</p>
      </div>
      <div class="header-actions">
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="contact-form" class="editor-form">
      <div class="form-section">
        <h2 class="form-section-title">1. Primary Email</h2>
        <div class="input-group">
          <label for="email">Public Email Address <span class="required-asterisk">*</span></label>
          <input type="email" id="email" required placeholder="hello@example.com" />
          <span class="input-helper">This is the email address visitors will use to contact you.</span>
        </div>
      </div>

      <div class="form-section">
        <div class="socials-header">
          <h2 class="form-section-title">2. Social Links</h2>
          <button type="button" id="add-social-btn" class="action-btn add-btn">+ Add Link</button>
        </div>
        
        <div id="socials-container" class="socials-container">
          <!-- Social rows injected here -->
        </div>
        <span class="input-helper" style="margin-top:-0.5rem">Empty or incomplete rows will be ignored when saving.</span>
      </div>

      <div id="form-feedback" class="form-feedback"></div>

      <div class="form-actions">
        <div class="primary-actions">
          <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</MeLayout>

<template id="social-row-template">
  <div class="social-row">
    <div class="social-inputs">
      <input type="text" class="social-platform" placeholder="Platform (e.g. GitHub)" required />
      <input type="url" class="social-url" placeholder="https://..." required />
    </div>
    <button type="button" class="action-btn delete-btn remove-social-btn">Remove</button>
  </div>
</template>

<style>
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--bg-surface);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .form-section {
      padding: 2rem;
    }
  }

  .form-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .socials-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: -0.5rem;
  }

  .socials-header .form-section-title {
    border-bottom: none;
    padding-bottom: 0;
  }

  .socials-header .add-btn {
    margin-bottom: 0.75rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required-asterisk {
    color: #ef4444;
  }

  .input-helper {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .socials-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.social-row) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-end;
    padding: 1.25rem;
    background-color: var(--bg-main);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  :global(.social-inputs) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    :global(.social-row) {
      flex-direction: row;
      align-items: center;
      padding: 0;
      background-color: transparent;
      border: none;
    }
    :global(.social-inputs) {
      flex-direction: row;
      flex: 1;
    }
  }

  :global(.social-inputs input) {
    background-color: var(--bg-main);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
    width: 100%;
  }

  :global(.social-inputs input.social-platform) {
    flex: 0.5;
  }

  :global(.social-inputs input.social-url) {
    flex: 1;
  }

  :global(.social-inputs input:focus) {
    border-color: var(--accent-blue);
  }

  .form-actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    margin-top: 1rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .form-actions {
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
    }
  }

  .primary-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .primary-actions {
      flex-direction: row;
    }
  }

  .form-feedback {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
  }

  .form-feedback.success {
    display: block;
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-feedback.error {
    display: block;
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
</style>

<script>
import { db } from '../../lib/firebase';
import { ref as dbRef, get, set } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {

  const form = document.getElementById('contact-form') as HTMLFormElement;
  if (!form) return;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const socialsContainer = document.getElementById('socials-container') as HTMLDivElement;
  const addSocialBtn = document.getElementById('add-social-btn') as HTMLButtonElement;
  const template = document.getElementById('social-row-template') as HTMLTemplateElement;
  const feedbackEl = document.getElementById('form-feedback') as HTMLDivElement;
  
  function showFeedback(msg: string, type: 'success' | 'error') {
    feedbackEl.textContent = msg;
    feedbackEl.className = `form-feedback ${type}`;
    feedbackEl.style.display = 'block';
    setTimeout(() => {
      feedbackEl.style.display = 'none';
    }, 5000);
  }

  function createSocialRow(platform = '', url = '') {
    const clone = template.content.cloneNode(true) as DocumentFragment;
    const platformInput = clone.querySelector('.social-platform') as HTMLInputElement;
    const urlInput = clone.querySelector('.social-url') as HTMLInputElement;
    const removeBtn = clone.querySelector('.remove-social-btn') as HTMLButtonElement;
    
    platformInput.value = platform;
    urlInput.value = url;

    removeBtn.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest('.social-row');
      row?.remove();
    });

    socialsContainer.appendChild(clone);
  }

  addSocialBtn.addEventListener('click', () => {
    createSocialRow();
  });

  // On page load, fetch existing /contact
  get(dbRef(db, 'contact')).then(snapshot => {
    if (snapshot.exists()) {
      const data = snapshot.val();
      emailInput.value = data.email || '';
      
      if (data.socials && Array.isArray(data.socials)) {
        data.socials.forEach((s: any) => {
          createSocialRow(s.platform, s.url);
        });
      }
    } else {
      // Create one empty row by default if completely empty
      createSocialRow();
    }
  }).catch(err => {
    console.error("Failed to load contact data:", err);
    showFeedback("Failed to load contact data.", "error");
  });

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const emailVal = emailInput.value.trim();

    if (!emailVal) {
      showFeedback("Email is required.", "error");
      return;
    }

    const socialRows = socialsContainer.querySelectorAll('.social-row');
    const socialsArray: any[] = [];

    socialRows.forEach(row => {
      const pInput = row.querySelector('.social-platform') as HTMLInputElement;
      const uInput = row.querySelector('.social-url') as HTMLInputElement;
      const p = pInput.value.trim();
      const u = uInput.value.trim();

      // Only add if both fields are non-empty
      if (p && u) {
        socialsArray.push({ platform: p, url: u });
      }
    });

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const contactData = {
      email: emailVal,
      socials: socialsArray.length > 0 ? socialsArray : null
    };

    try {
      await set(dbRef(db, 'contact'), contactData);
      
      showFeedback("Contact information saved successfully!", "success");
      saveBtn.textContent = 'Save Changes';
      saveBtn.disabled = false;
      
    } catch (error) {
      console.error("Save error:", error);
      showFeedback("Error saving contact data. Check permissions.", "error");
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });
  });
</script>
