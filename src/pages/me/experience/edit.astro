---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Experience Editor | Portfolio Management" activeNav="experience">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title" id="form-title">Add Experience</h1>
      </div>
      <div class="header-actions">
        <a href="/me/experience" class="secondary-btn">Cancel</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="experience-form" class="editor-form">
      
      <div class="form-section">
        <h2 class="form-section-title">1. Role & Company</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="role">Role / Job Title <span class="required-asterisk">*</span></label>
            <input type="text" id="role" required placeholder="e.g. Senior Frontend Engineer" />
          </div>
          <div class="input-group">
            <label for="company">Company <span class="required-asterisk">*</span></label>
            <input type="text" id="company" required placeholder="e.g. Google" />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">2. Employment Period</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="startDate">Start Date <span class="required-asterisk">*</span></label>
            <input type="text" id="startDate" required placeholder="e.g. Jan 2021" />
          </div>
          <div class="input-group">
            <label for="endDate">End Date</label>
            <input type="text" id="endDate" placeholder="e.g. Present" />
            <span class="input-helper">Leave empty if this is your current role</span>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">3. Location</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="location">Location</label>
            <input type="text" id="location" placeholder="e.g. Remote, San Francisco" />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">4. Highlights</h2>
        <div class="input-group">
          <label for="highlights">Key Achievements</label>
          <textarea id="highlights" rows="6" placeholder="Led development of the new dashboard...&#10;Improved performance by 40%..."></textarea>
          <span class="input-helper">Enter one highlight per line. Each line becomes a bullet point.</span>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">5. Technology</h2>
        <div class="input-group">
          <label for="techStack">Tech Stack</label>
          <input type="text" id="techStack" placeholder="e.g. React, TypeScript, Node.js" />
          <span class="input-helper">Comma-separated list of technologies used</span>
        </div>
      </div>

      <div class="form-section publish-section">
        <h2 class="form-section-title">6. Visibility & Ordering</h2>
        <div class="form-row publish-row">
          <div class="input-group">
            <label for="order">Display Order</label>
            <input type="number" id="order" value="0" />
            <span class="input-helper">Lower numbers appear first</span>
          </div>
          <div class="checkbox-group-wrapper">
            <label class="checkbox-group">
              <input type="checkbox" id="published" />
              <div class="checkbox-labels">
                <span class="checkbox-title">Published Status</span>
                <span class="input-helper">Make this entry visible on the public portfolio</span>
              </div>
            </label>
          </div>
        </div>
      </div>

      <div id="form-feedback" class="form-feedback"></div>

      <div class="form-actions">
        <button type="button" class="action-btn delete-action-btn delete-btn" id="delete-btn" style="display: none;">Delete Experience</button>
        <div class="primary-actions">
          <a href="/me/experience" class="secondary-btn">Cancel</a>
          <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Experience</button>
        </div>
      </div>
    </form>
  </div>
</MeLayout>

<style>
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--bg-surface);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .form-section {
      padding: 2rem;
    }
  }

  .form-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label, .checkbox-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required-asterisk {
    color: #ef4444;
  }

  .input-helper {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .checkbox-group-wrapper {
    display: flex;
    align-items: center;
    height: 100%;
    padding-bottom: 0.5rem;
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }

  .checkbox-group input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    accent-color: var(--accent-blue);
    cursor: pointer;
  }

  .checkbox-labels {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .form-actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    margin-top: 1rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .form-actions {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .primary-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .primary-actions {
      flex-direction: row;
    }
  }

  .form-feedback {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
  }

  .form-feedback.success {
    display: block;
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-feedback.error {
    display: block;
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
</style>

<script>
import { db } from '../../../lib/firebase';
import { ref as dbRef, get, update, push, set, remove } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {

  const params = new URLSearchParams(window.location.search);
  const entryId = params.get('id');

  const form = document.getElementById('experience-form') as HTMLFormElement;
  if (!form) return;
  const formTitle = document.getElementById('form-title') as HTMLHeadingElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
  const feedbackEl = document.getElementById('form-feedback') as HTMLDivElement;
  
  function showFeedback(msg: string, type: 'success' | 'error') {
    feedbackEl.textContent = msg;
    feedbackEl.className = `form-feedback ${type}`;
    feedbackEl.style.display = 'block';
    setTimeout(() => {
      feedbackEl.style.display = 'none';
    }, 5000);
  }
  
  // Inputs
  const roleInput = document.getElementById('role') as HTMLInputElement;
  const companyInput = document.getElementById('company') as HTMLInputElement;
  const startDateInput = document.getElementById('startDate') as HTMLInputElement;
  const endDateInput = document.getElementById('endDate') as HTMLInputElement;
  const locationInput = document.getElementById('location') as HTMLInputElement;
  const highlightsInput = document.getElementById('highlights') as HTMLTextAreaElement;
  const techStackInput = document.getElementById('techStack') as HTMLInputElement;
  const orderInput = document.getElementById('order') as HTMLInputElement;
  const publishedInput = document.getElementById('published') as HTMLInputElement;

  if (entryId) {
    formTitle.textContent = 'Edit Experience';
    
    if (deleteBtn) {
      deleteBtn.style.display = 'block';
      deleteBtn.addEventListener('click', async () => {
        if (confirm('Are you sure you want to delete this experience entry? This cannot be undone.')) {
          try {
            await remove(dbRef(db, `experience/${entryId}`));
            window.location.assign('/me/experience');
          } catch (err) {
            console.error("Failed to delete entry:", err);
            showFeedback("Failed to delete entry. Check permissions.", "error");
          }
        }
      });
    }

    // Load existing data
    get(dbRef(db, `experience/${entryId}`)).then(snapshot => {
      if (snapshot.exists()) {
        const e = snapshot.val();
        roleInput.value = e.role || '';
        companyInput.value = e.company || '';
        startDateInput.value = e.startDate || '';
        endDateInput.value = e.endDate || '';
        locationInput.value = e.location || '';
        orderInput.value = e.order || '0';
        publishedInput.checked = !!e.published;
        
        if (e.highlights && Array.isArray(e.highlights)) {
          highlightsInput.value = e.highlights.join('\n');
        }
        if (e.techStack && Array.isArray(e.techStack)) {
          techStackInput.value = e.techStack.join(', ');
        }
      } else {
        alert("Experience entry not found.");
        window.location.assign('/me/experience');
      }
    }).catch(err => {
      console.error("Failed to load entry:", err);
      showFeedback("Failed to load experience data.", "error");
    });
  }

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Basic Validation
    if (!roleInput.value.trim() || !companyInput.value.trim() || !startDateInput.value.trim()) {
      showFeedback("Role, Company, and Start Date are required.", "error");
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';
    
    const highlightsArray = highlightsInput.value
      .split('\n')
      .map(s => s.trim())
      .filter(Boolean);

    const techStackArray = techStackInput.value
      .split(',')
      .map(s => s.trim())
      .filter(Boolean);

    const expData = {
      role: roleInput.value.trim(),
      company: companyInput.value.trim(),
      startDate: startDateInput.value.trim(),
      endDate: endDateInput.value.trim(),
      location: locationInput.value.trim(),
      order: parseInt(orderInput.value) || 0,
      highlights: highlightsArray,
      techStack: techStackArray,
      published: publishedInput.checked
    };

    // Remove empty strings
    Object.keys(expData).forEach(k => {
      if ((expData as any)[k] === '') {
        delete (expData as any)[k];
      }
    });

    try {
      if (entryId) {
        // Update existing
        await update(dbRef(db, `experience/${entryId}`), expData);
      } else {
        // Create new using push() to generate a unique ID
        const newRef = push(dbRef(db, 'experience'));
        await set(newRef, { ...expData, id: newRef.key });
      }
      showFeedback("Experience saved successfully!", "success");
      setTimeout(() => {
        window.location.assign('/me/experience');
      }, 500);
    } catch (error) {
      console.error("Save error:", error);
      showFeedback("Error saving experience. Check permissions.", "error");
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Experience';
    }
  });
  });
</script>
