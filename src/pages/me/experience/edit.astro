---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Experience Editor | Portfolio Management" activeNav="experience">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title" id="form-title">Add Experience</h1>
      </div>
      <div class="header-actions">
        <a href="/me/experience" class="secondary-btn">Cancel</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="experience-form" class="editor-form">
      
      <div class="form-row">
        <div class="input-group">
          <label for="role">Role / Job Title *</label>
          <input type="text" id="role" required placeholder="e.g. Senior Frontend Engineer" />
        </div>
        <div class="input-group">
          <label for="company">Company *</label>
          <input type="text" id="company" required placeholder="e.g. Google" />
        </div>
      </div>

      <div class="form-row">
        <div class="input-group">
          <label for="startDate">Start Date *</label>
          <input type="text" id="startDate" required placeholder="e.g. Jan 2021" />
        </div>
        <div class="input-group">
          <label for="endDate">End Date</label>
          <input type="text" id="endDate" placeholder="e.g. Present" />
        </div>
      </div>

      <div class="form-row">
        <div class="input-group">
          <label for="location">Location</label>
          <input type="text" id="location" placeholder="e.g. Remote" />
        </div>
        <div class="input-group">
          <label for="order">Display Order</label>
          <input type="number" id="order" value="0" />
        </div>
      </div>

      <div class="input-group">
        <label for="highlights">Highlights (One per line)</label>
        <textarea id="highlights" rows="5" placeholder="Led development of the new dashboard...&#10;Improved performance by 40%..."></textarea>
      </div>

      <div class="input-group">
        <label for="techStack">Tech Stack (Comma separated)</label>
        <input type="text" id="techStack" placeholder="e.g. React, TypeScript, Node.js" />
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="published" />
        <label for="published">Published (Visible on public portfolio)</label>
      </div>

      <div class="form-actions">
        <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Experience</button>
      </div>
    </form>
  </div>
</MeLayout>

<style>
  .cms-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .cms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .primary-btn {
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .primary-btn:hover {
    opacity: 0.9;
  }

  .primary-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .secondary-btn {
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .secondary-btn:hover {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1.5rem 0 2.5rem 0;
  }

  /* Form Styles */
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: var(--bg-surface);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .input-group input, .input-group textarea {
    background-color: var(--bg-main);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .input-group input:focus, .input-group textarea:focus {
    border-color: var(--accent-blue);
  }

  .checkbox-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
  }

  .checkbox-group input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--text-primary);
  }

  .checkbox-group label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
  }

  .form-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }
</style>

<script>
import { db } from '../../../lib/firebase';
import { ref as dbRef, get, update, push, set } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {
  
  

  const params = new URLSearchParams(window.location.search);
  const entryId = params.get('id');

  const form = document.getElementById('experience-form') as HTMLFormElement;
    if (!form) return;
  const formTitle = document.getElementById('form-title') as HTMLHeadingElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  
  // Inputs
  const roleInput = document.getElementById('role') as HTMLInputElement;
  const companyInput = document.getElementById('company') as HTMLInputElement;
  const startDateInput = document.getElementById('startDate') as HTMLInputElement;
  const endDateInput = document.getElementById('endDate') as HTMLInputElement;
  const locationInput = document.getElementById('location') as HTMLInputElement;
  const highlightsInput = document.getElementById('highlights') as HTMLTextAreaElement;
  const techStackInput = document.getElementById('techStack') as HTMLInputElement;
  const orderInput = document.getElementById('order') as HTMLInputElement;
  const publishedInput = document.getElementById('published') as HTMLInputElement;

  if (entryId) {
    formTitle.textContent = 'Edit Experience';
    
    // Load existing data
    get(dbRef(db, `experience/${entryId}`)).then(snapshot => {
      if (snapshot.exists()) {
        const e = snapshot.val();
        roleInput.value = e.role || '';
        companyInput.value = e.company || '';
        startDateInput.value = e.startDate || '';
        endDateInput.value = e.endDate || '';
        locationInput.value = e.location || '';
        orderInput.value = e.order || '0';
        publishedInput.checked = !!e.published;
        
        if (e.highlights && Array.isArray(e.highlights)) {
          highlightsInput.value = e.highlights.join('\n');
        }
        if (e.techStack && Array.isArray(e.techStack)) {
          techStackInput.value = e.techStack.join(', ');
        }
      } else {
        alert("Experience entry not found.");
        window.location.assign('/me/experience');
      }
    }).catch(err => {
      console.error("Failed to load entry:", err);
      alert("Failed to load experience data.");
    });
  }

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Basic Validation
    if (!roleInput.value.trim() || !companyInput.value.trim() || !startDateInput.value.trim()) {
      alert("Role, Company, and Start Date are required.");
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';
    
    const highlightsArray = highlightsInput.value
      .split('\n')
      .map(s => s.trim())
      .filter(Boolean);

    const techStackArray = techStackInput.value
      .split(',')
      .map(s => s.trim())
      .filter(Boolean);

    const expData = {
      role: roleInput.value.trim(),
      company: companyInput.value.trim(),
      startDate: startDateInput.value.trim(),
      endDate: endDateInput.value.trim(),
      location: locationInput.value.trim(),
      order: parseInt(orderInput.value) || 0,
      highlights: highlightsArray,
      techStack: techStackArray,
      published: publishedInput.checked
    };

    // Remove empty strings
    Object.keys(expData).forEach(k => {
      if ((expData as any)[k] === '') {
        delete (expData as any)[k];
      }
    });

    try {
      if (entryId) {
        // Update existing
        await update(dbRef(db, `experience/${entryId}`), expData);
      } else {
        // Create new using push() to generate a unique ID
        const newRef = push(dbRef(db, 'experience'));
        await set(newRef, { ...expData, id: newRef.key });
      }
      // Redirect back to list
      window.location.assign('/me/experience');
    } catch (error) {
      console.error("Save error:", error);
      alert('Error saving experience entry. Check permissions.');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Experience';
    }
  });
  });
</script>
