---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Projects | Portfolio Management" activeNav="projects">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Projects</h1>
        <p class="page-subtitle">Manage your portfolio projects</p>
      </div>
      <div class="header-actions">
        <a href="/me/projects/edit" class="primary-btn">Add Project</a>
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <div class="projects-list" id="projects-list">
      <p class="loading-text">Loading projects...</p>
    </div>
  </div>
</MeLayout>

<style>
  .cms-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .cms-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .primary-btn {
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .primary-btn:hover {
    opacity: 0.9;
  }

  .secondary-btn {
    background-color: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .secondary-btn:hover {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1.5rem 0 2rem 0;
  }

  .loading-text, .empty-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* List specific styles */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* We use global styles for project-item so the JS-injected HTML can see it cleanly,
     or we can use :global() */
  :global(.project-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
  }

  :global(.project-info) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  :global(.project-item-title) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  :global(.project-meta) {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  :global(.project-status) {
    width: 120px;
  }

  :global(.status-badge) {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
  }

  :global(.status-badge.published) {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.2);
  }

  :global(.status-badge.draft) {
    background-color: var(--bg-main);
    color: var(--text-secondary);
  }

  :global(.project-actions) {
    display: flex;
    gap: 0.75rem;
  }

  :global(.action-btn) {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  :global(.action-btn:hover) {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  :global(.delete-btn:hover) {
    color: #ef4444;
    border-color: #ef4444;
  }
</style>

<script>
import { db } from '../../../lib/firebase';
import { ref, onValue, remove } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {
  
  

  if ((window as any).__projectsUnsubscribe) {
    (window as any).__projectsUnsubscribe();
    (window as any).__projectsUnsubscribe = null;
  }

  const listEl = document.getElementById('projects-list');
  if (!listEl) return;

  const projectsRef = ref(db, 'projects');

  (window as any).__projectsUnsubscribe = onValue(projectsRef, (snapshot) => {
    
    if (!snapshot.exists()) {
      listEl.innerHTML = '<p class="empty-text">No projects found.</p>';
      return;
    }

    const projects: any[] = [];
    snapshot.forEach((child) => {
      projects.push({ dbKey: child.key, ...child.val() });
    });

    // Sort by order
    projects.sort((a, b) => (a.order || 0) - (b.order || 0));

    let html = '';
    projects.forEach(p => {
      html += `
        <div class="project-item">
          <div class="project-info">
            <h3 class="project-item-title">${p.title || 'Untitled'}</h3>
            <span class="project-meta">${p.category || 'Uncategorized'} • Order: ${p.order || 0}</span>
          </div>
          <div class="project-status">
            <span class="status-badge ${p.published ? 'published' : 'draft'}">${p.published ? 'Published' : 'Draft'}</span>
          </div>
          <div class="project-actions">
            <a href="/me/projects/edit?id=${p.dbKey}" class="action-btn">Edit</a>
            <button class="action-btn delete-btn" data-id="${p.dbKey}">Delete</button>
          </div>
        </div>
      `;
    });

    listEl.innerHTML = html;

    // Attach delete listeners
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLButtonElement).dataset.id;
        if (id && confirm('Are you sure you want to delete this project? This action cannot be undone.')) {
          try {
            await remove(ref(db, `projects/${id}`));
          } catch (err) {
            console.error('Failed to delete project:', err);
            alert('Failed to delete project.');
          }
        }
      });
    });
  });
  });
</script>
