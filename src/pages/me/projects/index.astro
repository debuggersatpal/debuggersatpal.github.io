---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Projects | Portfolio Management" activeNav="projects">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title">Projects</h1>
        <p class="page-subtitle">Manage your portfolio projects</p>
      </div>
      <div class="header-actions">
        <a href="/me/projects/edit" class="primary-btn">Add Project</a>
        <a href="/me" class="secondary-btn">Dashboard</a>
      </div>
    </header>

    <hr class="section-divider" />

    <div class="projects-list" id="projects-list">
      <p class="loading-text">Loading projects...</p>
    </div>
  </div>
</MeLayout>

<style>
  .loading-state, .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: 12px;
  }

  .loading-state-text, .empty-state-text {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .empty-state-sub {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--text-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
  }

  /* List specific styles */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.project-item) {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }

  :global(.project-item:hover) {
    border-color: var(--text-secondary);
  }

  @media (min-width: 640px) {
    :global(.project-item) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  :global(.project-info) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    min-width: 0; /* for text truncation if needed */
  }

  :global(.project-item-title) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.project-meta) {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  :global(.meta-dot) {
    opacity: 0.5;
  }

  :global(.project-status) {
    display: flex;
    align-items: center;
  }

  @media (min-width: 640px) {
    :global(.project-status) {
      width: 100px;
      justify-content: flex-end;
    }
  }

  :global(.status-indicator) {
    font-size: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
  }

  :global(.status-indicator::before) {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-secondary);
  }

  :global(.status-indicator.published) {
    color: var(--text-primary);
  }

  :global(.status-indicator.published::before) {
    background-color: #10b981;
  }

  :global(.project-actions) {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    :global(.project-actions) {
      margin-top: 0;
    }
  }
</style>

<script>
import { db } from '../../../lib/firebase';
import { ref, onValue, remove } from 'firebase/database';

  document.addEventListener('astro:page-load', () => {
  
  if ((window as any).__projectsUnsubscribe) {
    (window as any).__projectsUnsubscribe();
    (window as any).__projectsUnsubscribe = null;
  }

  const listEl = document.getElementById('projects-list');
  if (!listEl) return;
  
  // Initial loading state
  listEl.innerHTML = `
    <div class="loading-state">
      <div class="spinner"></div>
      <span class="loading-state-text">Loading workspace...</span>
    </div>
  `;

  const projectsRef = ref(db, 'projects');

  const unsubscribe = onValue(projectsRef, (snapshot) => {
    
    if (!snapshot.exists()) {
      listEl.innerHTML = `
        <div class="empty-state">
          <span class="empty-state-text">No projects found.</span>
          <p class="empty-state-sub">Get started by creating your first portfolio project.</p>
          <a href="/me/projects/edit" class="primary-btn">Create Project</a>
        </div>
      `;
      return;
    }

    const projects: any[] = [];
    snapshot.forEach((child) => {
      projects.push({ dbKey: child.key, ...child.val() });
    });

    // Sort by order
    projects.sort((a, b) => (a.order || 0) - (b.order || 0));

    let html = '';
    projects.forEach(p => {
      html += `
        <div class="project-item">
          <div class="project-info">
            <h3 class="project-item-title" title="${p.title || 'Untitled'}">${p.title || 'Untitled'}</h3>
            <div class="project-meta">
              <span>${p.category || 'Uncategorized'}</span>
              <span class="meta-dot">•</span>
              <span>Order: ${p.order || 0}</span>
            </div>
          </div>
          <div class="project-status">
            <span class="status-indicator ${p.published ? 'published' : 'draft'}">
              ${p.published ? 'Published' : 'Draft'}
            </span>
          </div>
          <div class="project-actions">
            <a href="/me/projects/edit?id=${p.dbKey}" class="action-btn">Edit</a>
            <button class="action-btn delete-btn" data-id="${p.dbKey}" aria-label="Delete ${p.title}">Delete</button>
          </div>
        </div>
      `;
    });

    listEl.innerHTML = html;

    // Attach delete listeners
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).dataset.id;
        if (id && confirm('Are you sure you want to delete this project? This action cannot be undone.')) {
          try {
            await remove(ref(db, `projects/${id}`));
          } catch (err) {
            console.error('Failed to delete project:', err);
            alert('Failed to delete project.');
          }
        }
      });
    });
  });

  (window as any).__projectsUnsubscribe = unsubscribe;

  document.addEventListener('astro:before-swap', () => {
    if ((window as any).__projectsUnsubscribe) {
      (window as any).__projectsUnsubscribe();
      (window as any).__projectsUnsubscribe = null;
    }
  }, { once: true });
  
  });
</script>
