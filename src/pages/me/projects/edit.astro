---
import MeLayout from '../../../layouts/MeLayout.astro';
---

<MeLayout title="Project Editor | Portfolio Management" activeNav="projects">
  <div class="cms-container">
    <header class="cms-header">
      <div>
        <h1 class="page-title" id="form-title">Add Project</h1>
      </div>
      <div class="header-actions">
        <a href="/me/projects" class="secondary-btn">Cancel</a>
      </div>
    </header>

    <hr class="section-divider" />

    <form id="project-form" class="editor-form">
      
      <div class="form-section">
        <h2 class="form-section-title">Basic Information</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="title">Title <span class="required-asterisk">*</span></label>
            <input type="text" id="title" required placeholder="e.g. MovieBase UI" />
          </div>
          <div class="input-group">
            <label for="id">Project ID (URL Slug) <span class="required-asterisk">*</span></label>
            <input type="text" id="id" required placeholder="e.g. moviebase" />
            <span class="input-helper">Used for the public URL routing</span>
          </div>
        </div>

        <div class="input-group">
          <label for="description">Description <span class="required-asterisk">*</span></label>
          <textarea id="description" rows="5" required placeholder="A detailed description of the project..."></textarea>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">Categorization & Technology</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="category">Category <span class="required-asterisk">*</span></label>
            <input type="text" id="category" required placeholder="e.g. Web Application" />
          </div>
          <div class="input-group">
            <label for="techStack">Tech Stack</label>
            <input type="text" id="techStack" placeholder="e.g. Next.js, Tailwind, TypeScript" />
            <span class="input-helper">Comma-separated list of technologies</span>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">External Links</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="demoUrl">Live Demo URL</label>
            <input type="url" id="demoUrl" placeholder="https://..." />
          </div>
          <div class="input-group">
            <label for="githubUrl">GitHub Repository</label>
            <input type="url" id="githubUrl" placeholder="https://github.com/..." />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">Project Media</h2>
        <div class="form-row">
          <div class="input-group">
            <label for="brandColor">Brand Color</label>
            <input type="text" id="brandColor" placeholder="e.g. #111827" />
            <span class="input-helper">Hex color code for branding</span>
          </div>
          <div class="input-group">
            <label for="fallbackText">Icon Fallback Text</label>
            <input type="text" id="fallbackText" placeholder="e.g. M" maxlength="3" />
            <span class="input-helper">1-3 letters shown if image is missing</span>
          </div>
        </div>

        <div class="image-upload-section">
          <div class="upload-header">
            <label>Project Icon Image</label>
            <span class="input-helper">Recommended: 256x256px</span>
          </div>
          <div class="upload-container">
            <div id="image-preview" class="image-preview-box">
              <span class="preview-placeholder">No Image</span>
            </div>
            <div class="upload-controls">
              <label for="iconFile" class="action-btn upload-btn">Choose File</label>
              <input type="file" id="iconFile" accept="image/*" class="sr-only" />
              <p class="upload-status" id="upload-status">No file chosen</p>
            </div>
          </div>
          <input type="hidden" id="iconImage" />
        </div>
      </div>

      <div class="form-section publish-section">
        <h2 class="form-section-title">Visibility & Ordering</h2>
        <div class="form-row publish-row">
          <div class="input-group">
            <label for="order">Display Order</label>
            <input type="number" id="order" value="0" />
            <span class="input-helper">Lower numbers appear first</span>
          </div>
          <div class="checkbox-group-wrapper">
            <label class="checkbox-group">
              <input type="checkbox" id="published" />
              <div class="checkbox-labels">
                <span class="checkbox-title">Published Status</span>
                <span class="input-helper">Make this project visible on the public portfolio</span>
              </div>
            </label>
          </div>
        </div>
      </div>

      <div id="form-feedback" class="form-feedback"></div>

      <div class="form-actions">
        <button type="button" class="action-btn delete-action-btn" id="delete-btn" style="display: none;">Delete Project</button>
        <div class="primary-actions">
          <a href="/me/projects" class="secondary-btn">Cancel</a>
          <button type="submit" class="primary-btn submit-btn" id="save-btn">Save Project</button>
        </div>
      </div>
    </form>
  </div>
</MeLayout>

<style>
  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--bg-surface);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .form-section {
      padding: 2rem;
    }
  }

  .form-section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
  
  .form-row.align-end {
    align-items: flex-end;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label, .upload-header label, .checkbox-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required-asterisk {
    color: #ef4444;
  }

  .input-helper {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .image-upload-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .upload-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background-color: var(--bg-main);
  }

  .image-preview-box {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .preview-placeholder {
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-align: center;
  }

  .upload-controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .upload-status {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .checkbox-group-wrapper {
    display: flex;
    align-items: center;
    height: 100%;
    padding-bottom: 0.5rem;
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }

  .checkbox-group input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    accent-color: var(--accent-blue);
    cursor: pointer;
  }

  .checkbox-labels {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .form-actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    margin-top: 1rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .form-actions {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .primary-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .primary-actions {
      flex-direction: row;
    }
  }

  .form-feedback {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
  }

  .form-feedback.success {
    display: block;
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-feedback.error {
    display: block;
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
</style>

<script>
import { db, storage } from '../../../lib/firebase';
import { ref as dbRef, get, set, update, remove } from 'firebase/database';
import { ref as storageRef, uploadBytes, getDownloadURL } from 'firebase/storage';

  document.addEventListener('astro:page-load', () => {
  
  const params = new URLSearchParams(window.location.search);
  const projectId = params.get('id');

  const form = document.getElementById('project-form') as HTMLFormElement;
  if (!form) return;
  const formTitle = document.getElementById('form-title') as HTMLHeadingElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
  const feedbackEl = document.getElementById('form-feedback') as HTMLDivElement;
  
  function showFeedback(msg: string, type: 'success' | 'error') {
    feedbackEl.textContent = msg;
    feedbackEl.className = `form-feedback ${type}`;
    feedbackEl.style.display = 'block';
    setTimeout(() => {
      feedbackEl.style.display = 'none';
    }, 5000);
  }

  // Inputs
  const idInput = document.getElementById('id') as HTMLInputElement;
  const orderInput = document.getElementById('order') as HTMLInputElement;
  const titleInput = document.getElementById('title') as HTMLInputElement;
  const descInput = document.getElementById('description') as HTMLTextAreaElement;
  const categoryInput = document.getElementById('category') as HTMLInputElement;
  const techStackInput = document.getElementById('techStack') as HTMLInputElement;
  const demoInput = document.getElementById('demoUrl') as HTMLInputElement;
  const githubInput = document.getElementById('githubUrl') as HTMLInputElement;
  const brandColorInput = document.getElementById('brandColor') as HTMLInputElement;
  const fallbackInput = document.getElementById('fallbackText') as HTMLInputElement;
  const publishedInput = document.getElementById('published') as HTMLInputElement;
  
  // Image Upload
  const iconImageHidden = document.getElementById('iconImage') as HTMLInputElement;
  const iconFileInput = document.getElementById('iconFile') as HTMLInputElement;
  const uploadStatus = document.getElementById('upload-status') as HTMLParagraphElement;
  const imagePreview = document.getElementById('image-preview') as HTMLDivElement;

  if (projectId) {
    formTitle.textContent = 'Edit Project';
    idInput.value = projectId;
    idInput.disabled = true; // DB Key shouldn't change once created
    
    // Show delete button
    if (deleteBtn) {
      deleteBtn.style.display = 'block';
      deleteBtn.addEventListener('click', async () => {
        if (confirm('Are you sure you want to delete this project? This cannot be undone.')) {
          try {
            await remove(dbRef(db, `projects/${projectId}`));
            window.location.assign('/me/projects');
          } catch (err) {
            console.error("Failed to delete project:", err);
            showFeedback("Failed to delete project. Check permissions.", "error");
          }
        }
      });
    }

    // Load existing data
    get(dbRef(db, `projects/${projectId}`)).then(snapshot => {
      if (snapshot.exists()) {
        const p = snapshot.val();
        orderInput.value = p.order || '0';
        titleInput.value = p.title || '';
        descInput.value = p.description || '';
        categoryInput.value = p.category || '';
        techStackInput.value = (p.techStack || []).join(', ');
        demoInput.value = p.demoUrl || '';
        githubInput.value = p.githubUrl || '';
        brandColorInput.value = p.brandColor || '';
        fallbackInput.value = p.fallbackText || '';
        publishedInput.checked = !!p.published;
        iconImageHidden.value = p.iconImage || '';

        if (p.iconImage) {
          imagePreview.innerHTML = `<img src="${p.iconImage}" alt="Icon" style="max-width: 64px; max-height: 64px; object-fit: cover;" />`;
        }
      } else {
        alert("Project not found.");
        window.location.assign('/me/projects');
      }
    }).catch(err => {
      console.error("Failed to load project:", err);
      showFeedback("Failed to load project data.", "error");
    });
  }

  // Handle Image Upload automatically on file selection
  iconFileInput.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    // Use idInput value for folder if provided, else use generic
    const folderId = idInput.value || 'new-project';
    // Remove spaces/special chars from filename for safety
    const safeFileName = file.name.replace(/[^a-zA-Z0-9.\-_]/g, '_');
    const sRef = storageRef(storage, `projects/${folderId}/${Date.now()}_${safeFileName}`);
    
    uploadStatus.textContent = 'Uploading image...';
    try {
      await uploadBytes(sRef, file);
      const url = await getDownloadURL(sRef);
      iconImageHidden.value = url;
      uploadStatus.textContent = 'Upload successful!';
      imagePreview.innerHTML = `<img src="${url}" alt="Preview" style="max-width: 64px; max-height: 64px; object-fit: cover;" />`;
    } catch (err) {
      console.error("Upload error:", err);
      uploadStatus.textContent = 'Upload failed.';
      showFeedback("Failed to upload image.", "error");
    }
  });

  // Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const dbKey = idInput.value.trim();
    if (!dbKey) {
      showFeedback("Project ID is required.", "error");
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Project';
      return;
    }
    
    const projectData = {
      id: dbKey,
      order: parseInt(orderInput.value) || 0,
      title: titleInput.value.trim(),
      description: descInput.value.trim(),
      category: categoryInput.value.trim(),
      techStack: techStackInput.value.split(',').map(s => s.trim()).filter(Boolean),
      demoUrl: demoInput.value.trim(),
      githubUrl: githubInput.value.trim(),
      brandColor: brandColorInput.value.trim(),
      fallbackText: fallbackInput.value.trim(),
      published: publishedInput.checked,
      iconImage: iconImageHidden.value
    };

    // Remove empty strings so Firebase stores clean data
    Object.keys(projectData).forEach(k => {
      if ((projectData as any)[k] === '') {
        delete (projectData as any)[k];
      }
    });

    try {
      if (projectId) {
        // Update existing
        await update(dbRef(db, `projects/${projectId}`), projectData);
      } else {
        // Create new
        await set(dbRef(db, `projects/${dbKey}`), projectData);
      }
      showFeedback("Project saved successfully!", "success");
      setTimeout(() => {
        window.location.assign('/me/projects');
      }, 500);
    } catch (error) {
      console.error("Save error:", error);
      showFeedback("Error saving project. Do you have correct permissions?", "error");
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Project';
    }
  });
  });
</script>
