---
import InnerLayout from '../../../layouts/InnerLayout.astro';
---

<InnerLayout title="Projects | Satpal">
  <section class="projects-page">
    <div class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="page-subtitle">Things I've built.</p>
    </div>

    <div class="filters-row">
      <div class="filter-pills" id="projects-filters">
        <button class="filter-pill active">All</button>
        <button class="filter-pill">Web Apps</button>
        <button class="filter-pill">Mobile Apps</button>
        <button class="filter-pill">Tools</button>
      </div>
      
      <div class="sort-dropdown">
        <select id="projects-sort" aria-label="Sort projects">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
        </select>
      </div>
    </div>

    <div id="projects-container" class="projects-grid">
      <p id="projects-loading" style="color: var(--text-secondary);">Loading projects...</p>
      <p id="projects-error" style="display: none; color: red;"></p>
      <p id="projects-empty" style="display: none; color: var(--text-secondary);">No projects found.</p>
    </div>

    <div class="more-coming">
      <p>More projects coming soon...</p>
    </div>
  </section>
</InnerLayout>

<!-- Template for Vanilla JS DOM hydration -->
<template id="project-card-template">
  <div class="projects-card group">
    <a href="#" class="card-link">
      <div class="card-thumbnail-wrapper">
        <img class="card-thumbnail" alt="" src="" />
      </div>
      <div class="card-content">
        <div class="card-header-row">
          <h3 class="card-title"></h3>
          <svg class="external-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </div>
        <p class="card-description"></p>
        <div class="card-tags"></div>
      </div>
    </a>
  </div>
</template>

<style>
  .projects-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-header {
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  
  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-top: var(--space-2);
  }

  .filters-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 768px) {
    .filters-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .filter-pills {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-2);
    scrollbar-width: none;
  }
  .filter-pills::-webkit-scrollbar {
    display: none;
  }

  .filter-pill {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }
  .filter-pill:hover {
    color: var(--text-primary);
  }
  .filter-pill.active {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .sort-dropdown select {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    outline: none;
    cursor: pointer;
  }

  .projects-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .more-coming {
    text-align: center;
    margin-top: var(--space-12);
    color: var(--text-tertiary);
    font-size: 0.9375rem;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border-subtle);
  }

  /* Card Styles */
  .projects-card {
    background: var(--bg-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-base);
  }
  .projects-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  
  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-thumbnail-wrapper {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--bg-inset);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-tertiary);
  }
  
  .card-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }
  .projects-card:hover .card-thumbnail {
    transform: scale(1.05);
  }

  .card-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .external-icon {
    color: var(--text-tertiary);
    transition: color var(--transition-fast);
  }
  .projects-card:hover .external-icon {
    color: var(--text-primary);
  }

  .card-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-tag {
    background: var(--bg-inset);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
</style>

<script>
  import { VisitorDataService } from '../../../lib/visitor-data';
  import type { ProjectSummary } from '../../../data/types';

  const container = document.getElementById('projects-container');
  const loading = document.getElementById('projects-loading');
  const error = document.getElementById('projects-error');
  const empty = document.getElementById('projects-empty');
  const template = document.getElementById('project-card-template') as HTMLTemplateElement;

  function renderProjects(projects: ProjectSummary[]) {
    if (!container || !template) return;
    
    Array.from(container.children).forEach(child => {
      if (!child.id.startsWith('projects-')) child.remove();
    });

    if (loading) loading.style.display = 'none';
    if (error) error.style.display = 'none';
    if (empty) empty.style.display = projects.length === 0 ? 'block' : 'none';

    projects.forEach(p => {
      const el = template.content.cloneNode(true) as DocumentFragment;
      
      const link = el.querySelector('.card-link') as HTMLAnchorElement;
      if (link) link.href = `/projects/detail/?id=${p.slug}`;
      
      const title = el.querySelector('.card-title');
      if (title) title.textContent = p.title;

      const desc = el.querySelector('.card-description');
      if (desc) desc.textContent = p.description || '';

      const img = el.querySelector('.card-thumbnail') as HTMLImageElement;
      if (img) {
        if (p.thumbnail) {
          VisitorDataService.resolveMediaUrl(p.thumbnail).then(url => { img.src = url; });
        } else {
          img.style.display = 'none';
          const wrapper = el.querySelector('.card-thumbnail-wrapper');
          if (wrapper) {
            wrapper.innerHTML = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>';
          }
        }
      }

      const tagsContainer = el.querySelector('.card-tags');
      if (tagsContainer && p.technologies) {
        p.technologies.forEach(tech => {
          const span = document.createElement('span');
          span.className = 'card-tag';
          span.textContent = tech;
          tagsContainer.appendChild(span);
        });
      }

      container.appendChild(el);
    });
  }

  async function init() {
    const pState = await VisitorDataService.getProjects((updated) => {
      renderProjects(updated);
    });

    if (pState.status === 'success') {
      renderProjects(pState.data);
    } else if (pState.status === 'error' && error && loading) {
      loading.style.display = 'none';
      error.textContent = pState.message;
      error.style.display = 'block';
    } else if (pState.status === 'empty' && empty && loading) {
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  init();
</script>
