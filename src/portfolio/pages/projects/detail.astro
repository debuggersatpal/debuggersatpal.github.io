---
import InnerLayout from '../../../layouts/InnerLayout.astro';
---

<InnerLayout title="Project Details">
  <div id="project-detail-container">
    <div id="project-loading" style="display: contents;">
      <article class="project-detail">
        <div class="skeleton-box" style="width: 60%; height: 40px; margin-bottom: var(--space-6);"></div>
        
        <div style="display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-6);">
          <div class="skeleton-box" style="width: 100%; height: 16px;"></div>
          <div class="skeleton-box" style="width: 100%; height: 16px;"></div>
          <div class="skeleton-box" style="width: 90%; height: 16px;"></div>
          <div class="skeleton-box" style="width: 95%; height: 16px;"></div>
          <div class="skeleton-box" style="width: 80%; height: 16px;"></div>
        </div>

        <div style="margin-top: var(--space-8);">
          <div class="skeleton-box" style="width: 100px; height: 24px; margin-bottom: var(--space-4);"></div>
          <div style="display: flex; gap: var(--space-2);">
            <div class="skeleton-box" style="width: 80px; height: 32px; border-radius: var(--radius-full);"></div>
            <div class="skeleton-box" style="width: 100px; height: 32px; border-radius: var(--radius-full);"></div>
            <div class="skeleton-box" style="width: 90px; height: 32px; border-radius: var(--radius-full);"></div>
          </div>
        </div>
      </article>
    </div>
    <div id="project-error" style="display: none; padding: var(--space-4); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-md); color: rgb(239, 68, 68); background: rgba(239, 68, 68, 0.05);"></div>
  </div>

  <template id="project-detail-template">
    <article class="project-detail">
      <h1 class="title"></h1>
      <div class="content" style="margin-top: var(--space-6); line-height: var(--leading-normal);"></div>
      
      <div style="margin-top: var(--space-8);">
        <h3 style="font-size: var(--text-base); color: var(--text-secondary);">Tech Stack</h3>
        <ul class="tech-stack" style="display: flex; gap: var(--space-2); list-style: none; padding: 0; flex-wrap: wrap;"></ul>
      </div>

      <div class="project-links" style="margin-top: var(--space-8); display: flex; gap: var(--space-4);"></div>
    </article>
  </template>

    <script>
    import { PublicDataService as VisitorDataService } from '../../../lib/public-fetch';

  function initDetailPage(doc: Document | Element = document) {


    const container = doc.querySelector('#project-detail-container');
    const loading = doc.querySelector('#project-loading');
    const error = doc.querySelector('#project-error');
    const template = doc.querySelector('#project-detail-template') as HTMLTemplateElement;

    function renderDetail(data: any, projectTitle?: string) {
      if (!container || !template) return;
      
      Array.from(container.children).forEach(child => {
        if (!child.id.startsWith('project-')) child.remove();
      });

      if (loading) loading.style.display = 'none';
      if (error) error.style.display = 'none';

      const el = template.content.cloneNode(true) as DocumentFragment;
      
      const title = el.querySelector('.title');
      if (title) {
        title.textContent = projectTitle || data.slug;
        document.title = `${projectTitle || data.slug} - Project Details`;
      }

      const content = el.querySelector('.content');
      if (content) {
        // Render Markdown and sanitize HTML
        import('marked').then(({ marked }) => {
          import('dompurify').then(({ default: DOMPurify }) => {
            const html = marked.parse(data.content || '') as string;
            content.innerHTML = DOMPurify.sanitize(html);
            content.querySelectorAll("img").forEach(img => {
              img.setAttribute("loading", "lazy");
              img.setAttribute("decoding", "async");
              img.classList.add("skeleton-box");
              img.style.minHeight = "200px";
              img.style.display = "block";
              img.style.width = "100%";
              img.style.backgroundColor = "var(--bg-inset)";
              img.onload = () => {
                img.classList.remove("skeleton-box");
                img.style.minHeight = "auto";
              };
            });
          });
        });
      }

      const techStack = el.querySelector('.tech-stack');
      if (techStack && data.techStack) {
        data.techStack.forEach((tech: string) => {
          const li = document.createElement('li');
          li.textContent = tech;
          li.style.background = 'var(--bg-surface)';
          li.style.padding = 'var(--space-1) var(--space-3)';
          li.style.borderRadius = 'var(--radius-full)';
          li.style.fontSize = 'var(--text-sm)';
          li.style.border = '1px solid var(--border-subtle)';
          techStack.appendChild(li);
        });
      }

      const linksContainer = el.querySelector('.project-links');
      if (linksContainer) {
        if (data.demoUrl) {
          const a = document.createElement('a');
          a.href = data.demoUrl;
          a.textContent = 'View Demo';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.style.padding = 'var(--space-2) var(--space-4)';
          a.style.background = 'var(--text-primary)';
          a.style.color = 'var(--bg-surface)';
          a.style.borderRadius = 'var(--radius-md)';
          a.style.textDecoration = 'none';
          a.style.fontWeight = '500';
          linksContainer.appendChild(a);
        }
        if (data.githubUrl) {
          const a = document.createElement('a');
          a.href = data.githubUrl;
          a.textContent = 'GitHub Repo';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.style.padding = 'var(--space-2) var(--space-4)';
          a.style.background = 'var(--bg-surface)';
          a.style.color = 'var(--text-primary)';
          a.style.border = '1px solid var(--border-subtle)';
          a.style.borderRadius = 'var(--radius-md)';
          a.style.textDecoration = 'none';
          a.style.fontWeight = '500';
          linksContainer.appendChild(a);
        }
      }

      container.appendChild(el);
    }



    function init() {
      const slug = container?.dataset.slug;
      if (!slug) return;

      let projectTitle = '';
      const summaryState = VisitorDataService.getCachedProjects();
      if (summaryState && summaryState.status === 'success') {
         const proj = summaryState.data.find(p => p.slug === slug);
         if (proj) projectTitle = proj.title;
      }
      
      VisitorDataService.getProjects().then(st => {
         if (st.status === 'success') {
            const proj = st.data.find(p => p.slug === slug);
            if (proj && proj.title !== projectTitle) {
               projectTitle = proj.title;
               const titleEl = doc.querySelector('.title');
               if (titleEl) titleEl.textContent = projectTitle;
            }
         }
      });

      const pCached = VisitorDataService.getCachedProjectDetail(slug);
      if (pCached && pCached.status === 'success') {
         renderDetail(pCached.data, projectTitle);
      } else if (pCached && pCached.status === 'error' && error && loading) {
         loading.style.display = 'none';
         error.textContent = pCached.message || 'Error loading project.';
         error.style.display = 'block';
      } else if (pCached && pCached.status === 'empty' && error && loading) {
         loading.style.display = 'none';
         error.textContent = 'Project not found.';
         error.style.display = 'block';
      }
      
      VisitorDataService.getProjectDetail(slug, (updated) => {
        renderDetail(updated, projectTitle);
      }).then(pState => {
        if (pState.status === 'success') renderDetail(pState.data, projectTitle);
        else if (pState.status === 'error' && error && loading) {
          loading.style.display = 'none';
          error.textContent = pState.message || 'Error loading project.';
          error.style.display = 'block';
        } else if (pState.status === 'empty' && error && loading) {
          loading.style.display = 'none';
          error.textContent = 'Project not found.';
          error.style.display = 'block';
        }
      });
    }



  }

  initDetailPage();
  document.addEventListener('astro:after-swap', () => initDetailPage());
</script>
</InnerLayout>
