---
import InnerLayout from '../../../layouts/InnerLayout.astro';
---

<InnerLayout title="Project Details">
  <div id="project-detail-container">
    <p id="project-loading" style="color: var(--text-secondary);">Loading project details...</p>
    <p id="project-error" style="display: none; color: red;"></p>
  </div>

  <template id="project-detail-template">
    <article class="project-detail">
      <h1 class="title"></h1>
      <div class="content" style="margin-top: var(--space-6); line-height: 1.6;"></div>
      
      <div style="margin-top: var(--space-8);">
        <h3 style="font-size: 1rem; color: var(--text-secondary);">Tech Stack</h3>
        <ul class="tech-stack" style="display: flex; gap: var(--space-2); list-style: none; padding: 0; flex-wrap: wrap;"></ul>
      </div>

      <div class="project-links" style="margin-top: var(--space-8); display: flex; gap: var(--space-4);"></div>
    </article>
  </template>

  <script>
    import { VisitorDataService } from '../../../lib/visitor-data';

    const container = document.getElementById('project-detail-container');
    const loading = document.getElementById('project-loading');
    const error = document.getElementById('project-error');
    const template = document.getElementById('project-detail-template') as HTMLTemplateElement;

    function renderDetail(data: any, projectTitle?: string) {
      if (!container || !template) return;
      
      Array.from(container.children).forEach(child => {
        if (!child.id.startsWith('project-')) child.remove();
      });

      if (loading) loading.style.display = 'none';
      if (error) error.style.display = 'none';

      const el = template.content.cloneNode(true) as DocumentFragment;
      
      const title = el.querySelector('.title');
      if (title) {
        title.textContent = projectTitle || data.slug;
        document.title = `${projectTitle || data.slug} - Project Details`;
      }

      const content = el.querySelector('.content');
      if (content) {
        // Render Markdown and sanitize HTML
        import('marked').then(({ marked }) => {
          import('dompurify').then(({ default: DOMPurify }) => {
            const html = marked.parse(data.content || '') as string;
            content.innerHTML = DOMPurify.sanitize(html);
          });
        });
      }

      const techStack = el.querySelector('.tech-stack');
      if (techStack && data.techStack) {
        data.techStack.forEach((tech: string) => {
          const li = document.createElement('li');
          li.textContent = tech;
          li.style.background = 'var(--bg-surface)';
          li.style.padding = 'var(--space-1) var(--space-3)';
          li.style.borderRadius = 'var(--radius-full)';
          li.style.fontSize = '0.875rem';
          li.style.border = '1px solid var(--border-subtle)';
          techStack.appendChild(li);
        });
      }

      const linksContainer = el.querySelector('.project-links');
      if (linksContainer) {
        if (data.demoUrl) {
          const a = document.createElement('a');
          a.href = data.demoUrl;
          a.textContent = 'View Demo';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.style.padding = 'var(--space-2) var(--space-4)';
          a.style.background = 'var(--text-primary)';
          a.style.color = 'var(--bg-surface)';
          a.style.borderRadius = 'var(--radius-md)';
          a.style.textDecoration = 'none';
          a.style.fontWeight = '500';
          linksContainer.appendChild(a);
        }
        if (data.githubUrl) {
          const a = document.createElement('a');
          a.href = data.githubUrl;
          a.textContent = 'GitHub Repo';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.style.padding = 'var(--space-2) var(--space-4)';
          a.style.background = 'var(--bg-surface)';
          a.style.color = 'var(--text-primary)';
          a.style.border = '1px solid var(--border-subtle)';
          a.style.borderRadius = 'var(--radius-md)';
          a.style.textDecoration = 'none';
          a.style.fontWeight = '500';
          linksContainer.appendChild(a);
        }
      }

      container.appendChild(el);
    }

    async function init() {
      const params = new URLSearchParams(window.location.search);
      const slug = params.get('id');

      if (!slug) {
        if (loading) loading.style.display = 'none';
        if (error) {
          error.textContent = 'Project slug not provided in URL.';
          error.style.display = 'block';
        }
        return;
      }

      // Fetch summary from public client (leverages Stale-While-Revalidate caching)
      const summaryState = await VisitorDataService.getProjects();
      let projectTitle = '';
      if (summaryState.status === 'success') {
        const matchingSummary = summaryState.data.find(s => s.slug === slug);
        if (matchingSummary) projectTitle = matchingSummary.title;
      }

      const pState = await VisitorDataService.getProjectDetail(slug, (updated) => {
        renderDetail(updated, projectTitle);
      });

      if (pState.status === 'success') {
        renderDetail(pState.data, projectTitle);
      } else if (pState.status === 'error' && error && loading) {
        loading.style.display = 'none';
        error.textContent = pState.message;
        error.style.display = 'block';
      } else if (pState.status === 'empty' && error && loading) {
        loading.style.display = 'none';
        error.textContent = 'Project not found.';
        error.style.display = 'block';
      }
    }

    init();
  </script>
</InnerLayout>
