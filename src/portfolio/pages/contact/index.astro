---
import InnerLayout from '../../../layouts/InnerLayout.astro';
---

<InnerLayout title="Contact | Satpal">
  <section class="contact-page">
    <div class="page-header">
      <h1 class="page-title">Get in Touch</h1>
      <p class="page-subtitle">Let's work together or just say hi!</p>
    </div>

    <div id="contact-container" class="contact-content">
      <p id="contact-loading" style="color: var(--text-secondary);">Loading contact information...</p>
      
      <div id="email-section" style="display: none;">
        <h2 class="section-heading">Email</h2>
        <div class="email-card">
          <div class="email-info">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="email-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div>
              <p class="email-label">Drop me a line</p>
              <p id="contact-email" class="email-address"></p>
            </div>
          </div>
          <button id="copy-email-btn" class="copy-btn" aria-label="Copy email address">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>

      <div id="socials-section" style="display: none; margin-top: var(--space-8);">
        <h2 class="section-heading">Socials</h2>
        <div id="socials-grid" class="socials-grid"></div>
      </div>
    </div>
  </section>
</InnerLayout>

<template id="social-card-template">
  <a href="#" class="social-card" target="_blank" rel="noopener">
    <div class="social-card-content">
      <div class="social-icon-wrapper" style="font-size: 24px; display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--bg-inset);">
      </div>
      <div class="social-text">
        <h3 class="social-handle"></h3>
        <p class="social-desc"></p>
      </div>
    </div>
    <svg class="external-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
  </a>
</template>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  
  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-top: var(--space-2);
  }

  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .email-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
  }
  .email-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .email-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .email-icon {
    color: var(--text-secondary);
  }

  .email-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 2px 0;
  }

  .email-address {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }

  .copy-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--bg-inset);
    border: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .copy-btn:hover {
    background: var(--bg-surface);
    border-color: var(--text-secondary);
  }

  .socials-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .socials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .social-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }
  .social-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--border-strong);
  }

  .social-card-content {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .social-handle {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 2px 0;
  }

  .social-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .external-icon {
    color: var(--text-tertiary);
    transition: color var(--transition-fast);
  }
  .social-card:hover .external-icon {
    color: var(--text-primary);
  }
</style>

<script>
  import { VisitorDataService } from '../../../lib/visitor-data';

  const loading = document.getElementById('contact-loading');
  const emailSection = document.getElementById('email-section');
  const emailEl = document.getElementById('contact-email');
  const copyBtn = document.getElementById('copy-email-btn');
  const socialsSection = document.getElementById('socials-section');
  const socialsGrid = document.getElementById('socials-grid');
  const socialTemplate = document.getElementById('social-card-template') as HTMLTemplateElement;

  function getSocialIcon(platform: string) {
    if (platform.toLowerCase() === 'github') return '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>';
    if (platform.toLowerCase() === 'linkedin') return '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>';
    if (platform.toLowerCase() === 'twitter' || platform.toLowerCase() === 'x') return '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>';
    return '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
  }

  async function init() {
    const cState = await VisitorDataService.getContact();
    if (loading) loading.style.display = 'none';

    if (cState.status === 'success') {
      const data = cState.data;
      
      if (data.email) {
        if (emailSection) emailSection.style.display = 'block';
        if (emailEl) emailEl.textContent = data.email;
        
        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(data.email).then(() => {
              const span = copyBtn.querySelector('span');
              if (span) {
                const orig = span.textContent;
                span.textContent = 'Copied!';
                setTimeout(() => { span.textContent = orig; }, 2000);
              }
            });
          });
        }
      }

      if (data.socials && data.socials.length > 0 && socialsSection && socialsGrid && socialTemplate) {
        socialsSection.style.display = 'block';
        
        data.socials.forEach(social => {
          const el = socialTemplate.content.cloneNode(true) as DocumentFragment;
          
          const a = el.querySelector('a');
          if (a) a.href = social.url;

          const iconWrapper = el.querySelector('.social-icon-wrapper');
          if (iconWrapper) iconWrapper.innerHTML = getSocialIcon(social.platform);

          const handle = el.querySelector('.social-handle');
          if (handle) handle.textContent = social.handle || social.platform;

          const desc = el.querySelector('.social-desc');
          if (desc) desc.textContent = social.description || `Follow on ${social.platform}`;

          socialsGrid.appendChild(el);
        });
      }
    }
  }

  init();
</script>
