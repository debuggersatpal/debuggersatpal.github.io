---
import VisitorLayout from '../../layouts/VisitorLayout.astro';
---

<VisitorLayout title="Satpal - Developer">

  <!-- ABOUT SECTION -->
  <div id="about">
    <section class="about-page">
    <div class="page-header fade-up">
      <h1 class="page-title">About Me</h1>
      <p class="page-subtitle">A brief story about me and my experience.</p>
    </div>

    <!-- Focus Areas -->
    <div class="section-container fade-up" style="margin-top: var(--space-8);">
      <h2 class="section-heading">Focus Areas</h2>
      <div id="focus-container" class="focus-grid">
        <p id="focus-loading" style="color: var(--text-secondary);">Loading focus areas...</p>
      </div>
    </div>

    <!-- Experience Timeline -->
    <div id="experience" class="section-container fade-up" style="margin-top: var(--space-12);">
      <h2 class="section-heading">Experience</h2>
      <div id="timeline-container" class="timeline-list">
        <p id="timeline-loading" style="color: var(--text-secondary);">Loading experience...</p>
      </div>
    </div>

    <!-- Skills -->
    <div id="skills" class="section-container fade-up" style="margin-top: var(--space-12); margin-bottom: var(--space-12);">
      <h2 class="section-heading">Skills & Technologies</h2>
      <div id="skills-container" class="skills-grid">
        <p id="skills-loading" style="color: var(--text-secondary);">Loading skills...</p>
      </div>
    </div>
  </section>
  </div>

  <!-- PROJECTS SECTION -->
  <div id="projects" style="margin-top: var(--space-16);">
    <section class="projects-section fade-up">
    <h1 class="section-title">All Projects & Works</h1>
    <p class="section-subtitle">Browse every project I've worked on.</p>

    <div class="filter-pills" id="projects-filters">
      <button class="filter-pill active">All</button>
      <button class="filter-pill">Web Apps</button>
      <button class="filter-pill">Mobile Apps</button>
      <button class="filter-pill">Tools</button>
      <button class="filter-pill">AI / ML</button>
      <button class="filter-pill">Systems</button>
    </div>

    <div id="projects-container" class="projects-grid">
      <p id="projects-loading" style="color: var(--text-secondary);">Loading projects...</p>
      <p id="projects-error" style="display: none; color: red;"></p>
      <p id="projects-empty" style="display: none; color: var(--text-secondary);">No projects found.</p>
    </div>
  </section>
  </div>

  <!-- CONTACT SECTION -->
  <div id="contact" style="margin-top: var(--space-16); margin-bottom: var(--space-16);">
    <section class="contact-page">
    <div class="page-header fade-up">
      <h1 class="page-title">Get in Touch</h1>
      <p class="page-subtitle">Let's work together or just say hi!</p>
    </div>

    <div id="contact-container" class="contact-content fade-up">
      <p id="contact-loading" style="color: var(--text-secondary);">Loading contact information...</p>
      
      <div id="email-section" style="display: none;">
        <h2 class="section-heading">Email</h2>
        <div class="email-card fade-up">
          <div class="email-info">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="email-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div>
              <p class="email-label">Drop me a line</p>
              <p id="contact-email" class="email-address"></p>
            </div>
          </div>
          <button id="copy-email-btn" class="copy-btn" aria-label="Copy email address">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>

      <div id="socials-section" style="display: none; margin-top: var(--space-8);">
        <h2 class="section-heading">Socials</h2>
        <div id="socials-grid" class="socials-grid"></div>
      </div>
    </div>
  </section>
  </div>

</VisitorLayout>

<!-- Templates for Vanilla JS DOM hydration -->
<template id="focus-template">
  <div class="focus-card fade-up">
    <h3 class="focus-title"></h3>
    <p class="focus-desc"></p>
  </div>
</template>

<template id="timeline-template">
  <div class="timeline-item fade-up">
    <div class="timeline-period-col">
      <p class="timeline-period"></p>
      <div class="timeline-line"></div>
    </div>
    <div class="timeline-content-col">
      <h3 class="timeline-role"></h3>
      <p class="timeline-company"></p>
      <ul class="timeline-bullets"></ul>
      <div class="timeline-techs"></div>
    </div>
  </div>
</template>

<template id="skill-group-template">
  <div class="skill-group fade-up">
    <h3 class="skill-category"></h3>
    <div class="skill-pills"></div>
  </div>
</template>

<template id="project-template">
    <div class="project-card group fade-up" style="position: relative;">
      <!-- Hidden full-card link for accessibility/clickability -->
      <a href="#" class="full-card-link" style="position: absolute; inset: 0; z-index: 1;">
        <span class="sr-only">View project details</span>
      </a>
      
      <div class="card-header">
        <div class="project-icon-wrapper">
          <img class="project-icon" alt="" />
        </div>
        <div class="project-tags"></div>
      </div>
      
      <h3 class="project-title"></h3>
      <p class="project-description text-pretty"></p>
      
      <!-- Interactive elements must have higher z-index to be clickable over the full-card link -->
      <div class="card-footer" style="position: relative; z-index: 2;">
        <a href="#" class="demo-link" target="_blank" rel="noopener">
          Live Demo
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
        <a href="#" class="github-link" target="_blank" rel="noopener" aria-label="View source code">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
      </div>
    </div>
  </template>

<template id="social-card-template">
  <a href="#" class="social-card" target="_blank" rel="noopener">
    <div class="social-card-content">
      <div class="social-icon-wrapper" style="font-size: 24px; display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--bg-inset);">
      </div>
      <div class="social-text">
        <h3 class="social-handle"></h3>
        <p class="social-desc"></p>
      </div>
    </div>
    <svg class="external-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
  </a>
</template>

<style>


  .about-page {
    display: flex;
    flex-direction: column;
  }

  .page-header {
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  
  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-top: var(--space-2);
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-6);
  }

  /* Focus Areas */
  .focus-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .focus-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .focus-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
  }
  
  .focus-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 var(--space-2) 0;
  }

  .focus-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.6;
  }

  /* Timeline */
  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: flex;
    flex-direction: row;
    gap: var(--space-6);
    position: relative;
    padding-bottom: var(--space-8);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-item:last-child .timeline-line {
    display: none;
  }

  .timeline-period-col {
    flex: 0 0 120px;
    position: relative;
    padding-top: var(--space-1);
  }

  .timeline-period {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
    margin: 0;
  }

  .timeline-line {
    position: absolute;
    top: 24px;
    bottom: -8px;
    left: 8px; /* rough center alignment depending on layout */
    width: 2px;
    background: var(--border-subtle);
    display: none; /* simple version for mobile, maybe visible on desktop */
  }

  @media (min-width: 768px) {
    .timeline-line {
      display: block;
      left: auto;
      right: -12px;
    }
    .timeline-period {
      text-align: right;
      padding-right: var(--space-6);
    }
  }

  .timeline-content-col {
    flex: 1;
  }

  .timeline-role {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
  }

  .timeline-company {
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
    margin-top: var(--space-1);
  }

  .timeline-bullets {
    margin: var(--space-4) 0 0 0;
    padding-left: var(--space-4);
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .timeline-techs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .timeline-tech-tag {
    background: var(--bg-inset);
    border: 1px solid var(--border-subtle);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skill-category {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-pill {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }


  .projects-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
  }
  
  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .filter-pill {
    background: transparent;
    border: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .filter-pill.active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg-surface);
  }

  .projects-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Project Card */
  .project-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: all var(--transition-base);
    height: 100%;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .project-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: var(--bg-inset);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .project-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
  }

  .project-tag {
    background: var(--bg-inset);
    border: 1px solid var(--border-subtle);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-primary);
  }

  .project-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .demo-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }
  .demo-link:hover {
    color: var(--accent-primary);
  }

  .github-link {
    color: var(--text-tertiary);
    transition: color var(--transition-fast);
  }
  .github-link:hover {
    color: var(--text-primary);
  }


  .contact-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  
  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-top: var(--space-2);
  }

  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .email-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
  }
  .email-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .email-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .email-icon {
    color: var(--text-secondary);
  }

  .email-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 2px 0;
  }

  .email-address {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }

  .copy-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--bg-inset);
    border: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .copy-btn:hover {
    background: var(--bg-surface);
    border-color: var(--text-secondary);
  }

  .socials-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .socials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .social-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }
  .social-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: var(--border-strong);
  }

  .social-card-content {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .social-handle {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 2px 0;
  }

  .social-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .external-icon {
    color: var(--text-tertiary);
    transition: color var(--transition-fast);
  }
  .social-card:hover .external-icon {
    color: var(--text-primary);
  }


</style>

<script>
  import { VisitorDataService } from '../../lib/visitor-data';
  import type { Profile, Experience, Capability, ProjectSummary, Contact } from '../../data/types';

  document.addEventListener('astro:page-load', () => {
    // --- ABOUT DOM ---
    const focusContainer = document.getElementById('focus-container');
    const focusLoading = document.getElementById('focus-loading');
    const focusTemplate = document.getElementById('focus-template') as HTMLTemplateElement;
  
    const timelineContainer = document.getElementById('timeline-container');
    const timelineLoading = document.getElementById('timeline-loading');
    const timelineTemplate = document.getElementById('timeline-template') as HTMLTemplateElement;
  
    const skillsContainer = document.getElementById('skills-container');
    const skillsLoading = document.getElementById('skills-loading');
    const skillGroupTemplate = document.getElementById('skill-group-template') as HTMLTemplateElement;

    // --- PROJECTS DOM ---
    const projectsContainer = document.getElementById('projects-container');
    const projectsLoading = document.getElementById('projects-loading');
    const projectsError = document.getElementById('projects-error');
    const projectsEmpty = document.getElementById('projects-empty');
    const projectTemplate = document.getElementById('project-template') as HTMLTemplateElement;

    // --- CONTACT DOM ---
    const emailSection = document.getElementById('email-section');
    const contactEmail = document.getElementById('contact-email');
    const socialsSection = document.getElementById('socials-section');
    const socialsGrid = document.getElementById('socials-grid');
    const contactLoading = document.getElementById('contact-loading');
    const copyBtn = document.getElementById('copy-email-btn');

    // --- ABOUT RENDER FUNCTIONS ---
    function renderFocus(profile: Profile) {
      if (!focusContainer || !focusTemplate) return;
      if (focusLoading) focusLoading.style.display = 'none';
  
      if (profile.focusAreas && profile.focusAreas.length > 0) {
        profile.focusAreas.forEach(area => {
          const el = focusTemplate.content.cloneNode(true) as DocumentFragment;
          const title = el.querySelector('.focus-title');
          if (title) title.textContent = area.title;
          const desc = el.querySelector('.focus-desc');
          if (desc) desc.textContent = area.description;
          focusContainer.appendChild(el);
        });
      }
    }
  
    function renderTimeline(experience: Experience[]) {
      if (!timelineContainer || !timelineTemplate) return;
      if (timelineLoading) timelineLoading.style.display = 'none';
  
      experience.forEach(e => {
        const el = timelineTemplate.content.cloneNode(true) as DocumentFragment;
        
        const period = el.querySelector('.timeline-period');
        if (period) period.textContent = e.period;
        const role = el.querySelector('.timeline-role');
        if (role) role.textContent = e.role;
        const company = el.querySelector('.timeline-company');
        if (company) company.textContent = e.company;
        const bullets = el.querySelector('.timeline-bullets');
        if (bullets && e.description) {
          const lines = e.description.split('\n').filter(l => l.trim().length > 0);
          if (lines.length > 0) {
            lines.forEach(line => {
              const li = document.createElement('li');
              li.textContent = line.replace(/^- /, '').trim();
              bullets.appendChild(li);
            });
          } else {
            const li = document.createElement('li');
            li.textContent = e.description;
            bullets.appendChild(li);
          }
        }
        const techs = el.querySelector('.timeline-techs');
        if (techs && e.technologies) {
          e.technologies.forEach(tech => {
            const span = document.createElement('span');
            span.className = 'timeline-tech-tag';
            span.textContent = tech;
            techs.appendChild(span);
          });
        }
        timelineContainer.appendChild(el);
      });
    }
  
    function renderSkills(capabilities: Capability[]) {
      if (!skillsContainer || !skillGroupTemplate) return;
      if (skillsLoading) skillsLoading.style.display = 'none';
  
      capabilities.forEach(cap => {
        const el = skillGroupTemplate.content.cloneNode(true) as DocumentFragment;
        const cat = el.querySelector('.skill-category');
        if (cat) cat.textContent = cap.category;
        const pills = el.querySelector('.skill-pills');
        if (pills && cap.skills) {
          cap.skills.forEach(skill => {
            const span = document.createElement('span');
            span.className = 'skill-pill';
            span.textContent = skill;
            pills.appendChild(span);
          });
        }
        skillsContainer.appendChild(el);
      });
    }

    // --- PROJECTS RENDER FUNCTIONS ---
    function renderProjects(projects: ProjectSummary[]) {
      if (!projectsContainer || !projectTemplate) return;
      
      Array.from(projectsContainer.children).forEach(child => {
        if (!child.id.startsWith('projects-')) child.remove();
      });
  
      if (projectsLoading) projectsLoading.style.display = 'none';
      if (projectsError) projectsError.style.display = 'none';
      if (projectsEmpty) projectsEmpty.style.display = projects.length === 0 ? 'block' : 'none';
  
      projects.forEach(p => {
        const el = projectTemplate.content.cloneNode(true) as DocumentFragment;
        
        const fullLink = el.querySelector('.full-card-link') as HTMLAnchorElement;
        if (fullLink) fullLink.href = `/projects/detail/?id=${p.slug}`;
  
        const title = el.querySelector('.project-title');
        if (title) title.textContent = p.title;
  
        const desc = el.querySelector('.project-description');
        if (desc) desc.textContent = p.description || '';
  
        const icon = el.querySelector('.project-icon') as HTMLImageElement;
        if (icon) {
          if (p.icon) {
            VisitorDataService.resolveMediaUrl(p.icon).then(url => { icon.src = url; });
          } else if (p.thumbnail) {
            VisitorDataService.resolveMediaUrl(p.thumbnail).then(url => { icon.src = url; });
          } else {
            icon.style.display = 'none';
            const wrapper = el.querySelector('.project-icon-wrapper');
            if (wrapper) {
              wrapper.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>';
            }
          }
        }
  
        const tagsContainer = el.querySelector('.project-tags');
        if (tagsContainer && p.technologies) {
          p.technologies.slice(0, 2).forEach(tech => {
            const span = document.createElement('span');
            span.className = 'project-tag';
            span.textContent = tech;
            tagsContainer.appendChild(span);
          });
        }
  
        const demo = el.querySelector('.demo-link') as HTMLAnchorElement;
        if (demo) {
          if (p.demoUrl) {
            demo.href = p.demoUrl;
          } else {
            demo.style.display = 'none';
          }
        }
  
        const github = el.querySelector('.github-link') as HTMLAnchorElement;
        if (github) {
          if (p.githubUrl) {
            github.href = p.githubUrl;
          } else {
            github.style.display = 'none';
          }
        }
  
        projectsContainer.appendChild(el);
      });
    }

    // --- CONTACT RENDER FUNCTIONS ---
    function renderContact(data: Contact) {
      if (contactLoading) contactLoading.style.display = 'none';
      
      if (data.email && emailSection && contactEmail) {
        contactEmail.textContent = data.email;
        emailSection.style.display = 'block';
        
        if (copyBtn) {
          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(data.email);
              const span = copyBtn.querySelector('span');
              if (span) {
                const originalText = span.textContent;
                span.textContent = 'Copied!';
                copyBtn.classList.add('copied');
                setTimeout(() => {
                  span.textContent = originalText;
                  copyBtn.classList.remove('copied');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy email: ', err);
            }
          });
        }
      }
  
      if (data.socials && data.socials.length > 0 && socialsSection && socialsGrid) {
        socialsGrid.innerHTML = ''; // clear loading state
        
        data.socials.forEach(social => {
          const a = document.createElement('a');
          a.href = social.url;
          a.className = 'social-link-card group fade-up';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
  
          // Generic icon fallback if specific platform icon isn't recognized
          let iconSvg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
          
          const platform = social.platform.toLowerCase();
          if (platform.includes('github')) {
            iconSvg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>';
          } else if (platform.includes('linkedin')) {
            iconSvg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>';
          } else if (platform.includes('twitter') || platform.includes('x')) {
            iconSvg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>';
          }
  
          a.innerHTML = `
            <div class="social-icon-wrapper">${iconSvg}</div>
            <div class="social-text">
              <p class="social-platform">${social.platform}</p>
              <p class="social-handle">${social.handle}</p>
            </div>
            <svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          `;
          
          socialsGrid.appendChild(a);
        });
        
        socialsSection.style.display = 'block';
      }
    }

    // --- INIT ---
    async function init() {
      // Fetch Profile for Focus Areas
      const pState = await VisitorDataService.getProfile();
      if (pState.status === 'success') {
        renderFocus(pState.data);
      }
  
      // Fetch Experience
      const eState = await VisitorDataService.getExperience();
      if (eState.status === 'success') {
        renderTimeline(eState.data);
      }
  
      // Fetch Capabilities (Skills)
      const cState = await VisitorDataService.getCapabilities();
      if (cState.status === 'success') {
        renderSkills(cState.data);
      }

      // Fetch Projects
      const projState = await VisitorDataService.getProjects((updated) => {
        renderProjects(updated);
      });
      if (projState.status === 'success') {
        renderProjects(projState.data);
      } else if (projState.status === 'error' && projectsError && projectsLoading) {
        projectsLoading.style.display = 'none';
        projectsError.textContent = projState.message;
        projectsError.style.display = 'block';
      } else if (projState.status === 'empty' && projectsEmpty && projectsLoading) {
        projectsLoading.style.display = 'none';
        projectsEmpty.style.display = 'block';
      }

      // Fetch Contact
      const contactState = await VisitorDataService.getContact();
      if (contactState.status === 'success') {
        renderContact(contactState.data);
      }
    }

    init();
  });
</script>
